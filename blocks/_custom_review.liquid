{% schema %}
{
  "name": "Star Rating Section",
  "settings": [
    {
      "type": "richtext",
      "id": "rating_suffix",
      "label": "Rating Suffix Text"
    }
  ],
  "presets": [
    {
      "name": "Star Rating Section"
    }
  ]
}
{% endschema %}
<div class="star-rating-section">
  <div class="stars">
    <svg class="icon-star" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M10 15.27l-5.5 3.2 1.05-6.13-4.45-4.34 6.15-.9L10 1.5l2.75 5.57 6.15.9-4.45 4.34 1.05 6.13z"/>
    </svg>
    <svg class="icon-star" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M10 15.27l-5.5 3.2 1.05-6.13-4.45-4.34 6.15-.9L10 1.5l2.75 5.57 6.15.9-4.45 4.34 1.05 6.13z"/>
    </svg>
    <svg class="icon-star" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M10 15.27l-5.5 3.2 1.05-6.13-4.45-4.34 6.15-.9L10 1.5l2.75 5.57 6.15.9-4.45 4.34 1.05 6.13z"/>
    </svg>
    <svg class="icon-star" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M10 15.27l-5.5 3.2 1.05-6.13-4.45-4.34 6.15-.9L10 1.5l2.75 5.57 6.15.9-4.45 4.34 1.05 6.13z"/>
    </svg>
    <svg class="icon-star" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M10 15.27l-5.5 3.2 1.05-6.13-4.45-4.34 6.15-.9L10 1.5l2.75 5.57 6.15.9-4.45 4.34 1.05 6.13z"/>
    </svg>
  </div>
  <div class="rating-text">
    {{ block.settings.rating_suffix }}
  </div>
</div>

{% stylesheet %}
  .star-rating-section {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    color: #333;
  }
  .stars {
    color: #f5a623; /* gold color */
    font-size: 20px;
    line-height: 1;
  }
  .rating-text {
    font-size: 16px;
  }
{% endstylesheet %}
