{% doc %}
  @prompt
    create 6 buttons, buttons position = face to face, All 6 buttons will be in straight one line and buttons width 93px, height 34px

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-button-row-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.button_spacing }}px;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
    justify-content: {{ block.settings.alignment }};
    align-items: center;
  }

  .ai-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 93px;
    height: 34px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
  }

  .ai-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-1px);
  }

  .ai-button-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.button_background_color }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-button-row-{{ ai_gen_id }} {
      gap: {{ block.settings.button_spacing | times: 0.75 }}px;
      padding: {{ block.settings.section_padding | times: 0.75 }}px;
      {% if block.settings.mobile_layout == 'wrap' %}
        justify-content: center;
      {% else %}
        overflow-x: auto;
        flex-wrap: nowrap;
        justify-content: flex-start;
        padding-bottom: {{ block.settings.section_padding | times: 0.75 | plus: 10 }}px;
      {% endif %}
    }

    {% if block.settings.mobile_layout == 'scroll' %}
      .ai-button-row-{{ ai_gen_id }}::-webkit-scrollbar {
        height: 4px;
      }

      .ai-button-row-{{ ai_gen_id }}::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 2px;
      }

      .ai-button-row-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
        background: {{ block.settings.button_background_color }};
        border-radius: 2px;
      }
    {% endif %}

    .ai-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-button-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% liquid
    assign buttons = ''
    for i in (1..6)
      assign button_text_key = 'button_' | append: i | append: '_text'
      assign button_link_key = 'button_' | append: i | append: '_link'
      assign button_text = block.settings[button_text_key]
      assign button_link = block.settings[button_link_key]
      
      if button_text != blank
        assign button_data = button_text | append: '|' | append: button_link
        if buttons == blank
          assign buttons = button_data
        else
          assign buttons = buttons | append: ',' | append: button_data
        endif
      endif
    endfor
    
    assign button_array = buttons | split: ','
  %}

  {% for button_data in button_array %}
    {% assign button_parts = button_data | split: '|' %}
    {% assign button_text = button_parts[0] %}
    {% assign button_link = button_parts[1] %}
    
    <a 
      href="{{ button_link | default: '#' }}" 
      class="ai-button-{{ ai_gen_id }}"
      {% if button_link == blank %}aria-disabled="true"{% endif %}
      title="{{ button_text }}"
    >
      {{ button_text }}
    </a>
  {% endfor %}
</div>

