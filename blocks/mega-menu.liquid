{% style %}
    .mega-menu-block {
    border: 1px solid var(--border-color, #2a8edb);
    padding: var(--padding, 32px);
    background: #fff;
  }

  .mega-menu-inner {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 24px;
  }

  .menu-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .menu-list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }

  .menu-list li {
    margin-bottom: 6px;
  }

  .menu-list li a {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .menu-list li a:hover {
    color: var(--hover-color, #2a8edb);
  }

  .center {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .product-card img {
    max-width: 100%;
    border-radius: 8px;
  }

  .right .side-image {
    position: relative;
    background-size: cover;
    background-position: center;
    border-radius: inherit;
    min-height: 300px;
    display: flex;
    align-items: flex-end;
  }

  .right .overlay {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .right .side-content {
    position: relative;
    padding: 20px;
    z-index: 2;
  }

  .right .btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
  }

  .btn-icon {
    margin-left: 10px;
    border-radius: 50%;
    padding: 5px;
  }
{% endstyle %}

{% liquid
  assign s = block.settings
%}

<div class="mega-menu-block" {{ block.shopify_attributes }}>
  <div class="mega-menu-inner" style="--padding: {{ s.inner_padding }}px;">
    <!-- Left Column: Menus -->
    <div class="mega-menu-col left">
      <h4 class="menu-title" style="color: {{ s.accent_color }};">{{ s.left_title_1 }}</h4>
      {% if s.left_menu_1 != blank %}
        <ul class="menu-list">
          {% for link in linklists[s.left_menu_1].links %}
            <li>
              <a href="{{ link.url }}" style="color: {{ s.link_color }};">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      <h4 class="menu-title" style="color: {{ s.accent_color }};">{{ s.left_title_2 }}</h4>
      {% if s.left_menu_2 != blank %}
        <ul class="menu-list">
          {% for link in linklists[s.left_menu_2].links %}
            <li>
              <a href="{{ link.url }}" style="color: {{ s.link_color }};">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <!-- Center Column: Products -->
    <div class="mega-menu-col center">
      {% assign collection = collections[s.center_collection] %}
      {% if s.center_source == 'collection' and collection %}
        {% for product in collection.products limit: s.center_limit %}
          <div class="product-card">
            <a href="{{ product.url }}">
              <img src="{{ product.featured_image | img_url: '300x' }}" alt="{{ product.title }}">
              <p>
                <strong>{{ product.title }}</strong>
              </p>
            </a>
          </div>
        {% endfor %}
      {% elsif s.center_source == 'manual' and s.center_products.size > 0 %}
        {% for product in s.center_products limit: s.center_limit %}
          <div class="product-card">
            <a href="{{ product.url }}">
              <img src="{{ product.featured_image | img_url: '300x' }}" alt="{{ product.title }}">
              <p>
                <strong>{{ product.title }}</strong>
              </p>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Right Column: Image & CTA -->
    <div class="mega-menu-col right" style="border-radius: {{ s.corner_radius }}px;">
      {% if s.side_image %}
        <div class="side-image" style="background-image: url({{ s.side_image | img_url: '600x' }});">
          <div
            class="overlay"
            style="background-color: {{ s.side_overlay_color }}; opacity: {{ s.side_overlay_opacity | divided_by: 100.0 }};"
          ></div>
          <div class="side-content">
            <h3>{{ s.side_heading }}</h3>
            <p>{{ s.side_text }}</p>
            {% if s.btn_text != blank %}
              <a class="btn" href="{{ s.btn_url }}" style="background: {{ s.btn_bg }}; color: {{ s.btn_text_color }};">
                {{ s.btn_text }}
                <span class="btn-icon" style="background: {{ s.btn_icon_bg }};">→</span>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mega menu",
  "tag": null,
  "settings": [
    { "type": "text", "id": "menu_handle", "label": "Handle", "default": "pets" },

    { "type": "header", "content": "Left column – Menus" },
    { "type": "text", "id": "left_title_1", "label": "Heading #1", "default": "Lifestyle/Breed" },
    { "type": "link_list", "id": "left_menu_1", "label": "Menu #1" },
    { "type": "text", "id": "left_title_2", "label": "Heading #2", "default": "Food Type" },
    { "type": "link_list", "id": "left_menu_2", "label": "Menu #2" },

    { "type": "header", "content": "Center – Products" },
    {
      "type": "select",
      "id": "center_source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "manual", "label": "Manual" }
      ],
      "default": "manual"
    },
    { "type": "collection", "id": "center_collection", "label": "Collection" },
    { "type": "product_list", "id": "center_products", "label": "Manual Products" },
    { "type": "range", "id": "center_limit", "label": "Product limit", "min": 2, "max": 6, "step": 1, "default": 3 },

    { "type": "header", "content": "Right – Image & CTA" },
    { "type": "image_picker", "id": "side_image", "label": "Side image" },
    { "type": "color", "id": "side_overlay_color", "label": "Overlay color", "default": "#dff0ff" },
    { "type": "range", "id": "side_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "default": 60 },
    { "type": "text", "id": "side_heading", "label": "Heading", "default": "Let’s Find Your Pet’s Perfect Formula" },
    {
      "type": "textarea",
      "id": "side_text",
      "label": "Text",
      "default": "Take the 60-second quiz to find the best formula."
    },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "Take the Quiz" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Heading color", "default": "#2a8edb" },
    { "type": "color", "id": "link_color", "label": "Link color", "default": "#222" },
    { "type": "color", "id": "link_hover_color", "label": "Link hover color", "default": "#2a8edb" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#207ed6" },
    { "type": "color", "id": "btn_text_color", "label": "Button text color", "default": "#fff" },
    { "type": "color", "id": "btn_icon_bg", "label": "Button icon background", "default": "#4aa2ea" },
    { "type": "range", "id": "inner_padding", "label": "Padding", "min": 12, "max": 60, "step": 2, "default": 32 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "default": 12 }
  ]
}
{% endschema %}
