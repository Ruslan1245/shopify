<section id="quiz-banner-{{ section.id }}" class="quiz-banner-section">
  <div class="quiz-banner-bg quiz-intro"
       style="background-image: url('{{ section.settings.bg_image | img_url: "1600x" }}');">
    <div class="quiz-banner-overlay"
         style="background-color: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | default: 40 | divided_by: 100 }};">
    </div>

    <div class="quiz-banner-content">
      {% if section.settings.heading_image %}
        <img src="{{ section.settings.heading_image | img_url: '400x' }}" alt="Heading image" class="quiz-heading-img">
      {% endif %}
      <h2 class="quiz-banner-heading">{{ section.settings.heading }}</h2>

      {% if section.settings.text_image %}
        <img src="{{ section.settings.text_image | img_url: '400x' }}" alt="Text image" class="quiz-text-img">
      {% endif %}
      <p class="quiz-banner-text">{{ section.settings.text }}</p>

      <a href="#" class="quiz-banner-btn" id="quiz-start-btn-{{ section.id }}">
        {{ section.settings.btn_text }} →
      </a>
    </div>
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'step1' %}
      <div class="quiz-step quiz-step-1" style="display:none;">
        <div class="quiz-progress" role="status" aria-live="polite">
          <span>{{ block.settings.step_label }}</span>
          <div class="quiz-progress-bar" aria-hidden="true"><div style="width:{{ block.settings.step_progress }}%"></div></div>
          <span>{{ block.settings.step_progress }}%</span>
        </div>

        {% if section.settings.show_rating %}
          <div class="quiz-rating">
            {% for i in (1..section.settings.rating_stars) %}
              ★
            {% endfor %}
            <span class="quiz-rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}

        <h2 class="quiz-step-heading">{{ block.settings.step_heading }}</h2>
        <p class="quiz-step-subtext">{{ block.settings.step_subtext }}</p>

        <div class="quiz-options" role="list">
          <button type="button" class="quiz-option" data-choice="cat" role="listitem" aria-pressed="false">
            {% if block.settings.cat_image %}
              <img src="{{ block.settings.cat_image | img_url: '300x' }}" alt="Cat option" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.option1 }}</span>
          </button>

          <button type="button" class="quiz-option" data-choice="dog" role="listitem" aria-pressed="false">
            {% if block.settings.dog_image %}
              <img src="{{ block.settings.dog_image | img_url: '300x' }}" alt="Dog option" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.option2 }}</span>
          </button>
        </div>

        <div class="quiz-nav">
          <button type="button" class="quiz-back">{{ block.settings.back_text }}</button>
          <button type="button" class="quiz-next">{{ block.settings.next_text }}</button>
        </div>

        <div class="quiz-review" style="display:none;">
          {% if section.settings.review_image %}
            <img src="{{ section.settings.review_image | img_url: '100x' }}" alt="Review image">
          {% endif %}
          <div>
            <p>{{ section.settings.review_text }}</p>
            <strong>{{ section.settings.review_author }} <span class="verified">✔ Verified Customer</span></strong>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</section>

<style>
.quiz-banner-section { position: relative; width:100%; text-align:center; }
.quiz-banner-bg { min-height:360px; display:flex; align-items:center; justify-content:center; position:relative; background-size:cover; background-position:center; }
.quiz-banner-overlay { position:absolute; top:0; left:0; right:0; bottom:0; z-index:1; }
.quiz-banner-content { position:relative; z-index:2; color:#fff; max-width:700px; padding:40px 20px; }
.quiz-banner-heading { font-size:32px; font-weight:700; margin-bottom:14px; }
.quiz-banner-text { font-size:16px; margin-bottom:22px; }
.quiz-banner-btn { display:inline-block; background:#f2c94c; color:#000; font-weight:600; padding:14px 28px; border-radius:30px; text-decoration:none; transition:.3s; }
.quiz-banner-btn:hover { background:#e5b93c; }

.quiz-step { padding:40px 20px; }
.quiz-progress { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; gap:12px; }
.quiz-progress-bar { flex:1; height:8px; background:#eee; margin:0 10px; border-radius:4px; overflow:hidden; }
.quiz-progress-bar div { height:100%; background:#3b82f6; }

.quiz-rating { font-size:20px; color:#fbbf24; margin-bottom:10px; display:flex; justify-content:center; align-items:center; gap:8px; }
.quiz-rating-text { font-size:14px; color:#444; }

.quiz-step-heading { font-size:24px; font-weight:700; margin-bottom:8px; color:#1b4e8a; }
.quiz-step-subtext { font-size:16px; margin-bottom:20px; color:#666; }

.quiz-options { display:flex; justify-content:center; gap:20px; margin-bottom:20px; flex-wrap:wrap; }
.quiz-option { background:#e0f2fe; border:none; border-radius:20px; padding:20px; font-size:18px; cursor:pointer; transition:.18s; display:flex; flex-direction:column; align-items:center; gap:10px; color:#0f4b76; width:160px; }
.quiz-option:hover { background:#bae6fd; }
.quiz-option.active { background:#2f86d1; color:#fff; }
.quiz-option-img { width:100px; height:100px; object-fit:cover; border-radius:12px; }

.quiz-nav { display:flex; justify-content:center; gap:20px; margin-bottom:20px; }
.quiz-back, .quiz-next { padding:12px 24px; border-radius:30px; border:none; cursor:pointer; font-weight:600; }
.quiz-back { background:#f3f4f6; }
.quiz-next { background:#000; color:#fff; }

.quiz-review { display:flex; gap:15px; max-width:600px; margin:0 auto; background:#f9fafb; padding:15px; border-radius:12px; text-align:left; }
.quiz-review img { border-radius:50%; width:60px; height:60px; object-fit:cover; }
.quiz-review p { margin:0 0 6px; font-size:14px; color:#333; }
.quiz-review strong { font-size:14px; }
.verified { color:#3b82f6; font-weight:600; }

.quiz-heading-img, .quiz-text-img { max-width:120px; margin:0 auto 15px; display:block; }

@media(max-width:768px){
  .quiz-banner-heading{font-size:24px;}
  .quiz-banner-text{font-size:14px;}
  .quiz-options { flex-direction:column; align-items:center; }
  .quiz-option { width:100%; max-width:260px; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){
  var container = document.getElementById('quiz-banner-{{ section.id }}');
  if(!container) return;

  var startBtn = container.querySelector('#quiz-start-btn-{{ section.id }}');
  var intro = container.querySelector('.quiz-intro');
  var step1 = container.querySelector('.quiz-step-1');
  var backBtn = container.querySelector('.quiz-back');
  var nextBtn = container.querySelector('.quiz-next');
  var options = container.querySelectorAll('.quiz-option');
  var reviewBox = container.querySelector('.quiz-review');

  if(startBtn){
    startBtn.addEventListener('click', function(e){
      e.preventDefault();
      if(intro) intro.style.display = 'none';
      if(step1) step1.style.display = 'block';
      if(reviewBox) reviewBox.style.display = 'flex';
    });
  }

  if(backBtn){
    backBtn.addEventListener('click', function(){
      if(step1) step1.style.display = 'none';
      if(intro) intro.style.display = '';
      if(reviewBox) reviewBox.style.display = 'none';
    });
  }

  options.forEach(function(opt){
    opt.addEventListener('click', function(){
      options.forEach(function(o){ o.classList.remove('active'); o.setAttribute('aria-pressed', 'false'); });
      this.classList.add('active');
      this.setAttribute('aria-pressed', 'true');
      container.dataset.selection = this.getAttribute('data-choice');
    });
  });

  if(nextBtn){
    nextBtn.addEventListener('click', function(){
      var selected = container.dataset.selection;
      if(!selected){
        alert('Please choose an option to continue.');
        return;
      }
      console.log('Next clicked with choice:', selected);
    });
  }
});
</script>

{% schema %}
{
  "name": "Quiz Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Overlay Opacity", "default": 40 },
    { "type": "image_picker", "id": "heading_image", "label": "Optional Heading Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find The Perfect Nutram Recipe In 30 Seconds" },
    { "type": "image_picker", "id": "text_image", "label": "Optional Text Image" },
    { "type": "text", "id": "text", "label": "Subtext", "default": "Answer a few quick questions, get a custom dry-food plan and 10% off your first bag." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Start Quiz" },

    { "type": "checkbox", "id": "show_rating", "label": "Show Rating on Steps", "default": true },
    { "type": "range", "id": "rating_stars", "label": "Number of Stars", "min": 1, "max": 5, "default": 5 },
    { "type": "text", "id": "rating_text", "label": "Rating Text", "default": "Rated 5.0 by 300+ customers" },

    { "type": "image_picker", "id": "review_image", "label": "Review Image" },
    { "type": "text", "id": "review_text", "label": "Review Text", "default": "\"After switching, Max’s coat is shinier and tummy trouble disappeared in two weeks!\"" },
    { "type": "text", "id": "review_author", "label": "Review Author", "default": "John D." }
  ],
  "blocks": [
    {
      "type": "step1",
      "name": "Step 1",
      "settings": [
        { "type": "text", "id": "step_label", "label": "Step Label", "default": "Step 1" },
        { "type": "range", "id": "step_progress", "label": "Progress %", "min": 0, "max": 100, "default": 40 },
        { "type": "text", "id": "step_heading", "label": "Heading", "default": "Who Are We Feeding Today?" },
        { "type": "text", "id": "step_subtext", "label": "Subtext", "default": "Choose one as you want." },
        { "type": "text", "id": "option1", "label": "Option 1 Label", "default": "Cat" },
        { "type": "image_picker", "id": "cat_image", "label": "Cat Image" },
        { "type": "text", "id": "option2", "label": "Option 2 Label", "default": "Dog" },
        { "type": "image_picker", "id": "dog_image", "label": "Dog Image" },
        { "type": "text", "id": "back_text", "label": "Back Button Text", "default": "← Go Back" },
        { "type": "text", "id": "next_text", "label": "Next Button Text", "default": "Next →" }
      ]
    }
  ],
  "presets": [{ "name": "Quiz Banner" }]
}
{% endschema %}
