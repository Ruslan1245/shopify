<script>
document.addEventListener('DOMContentLoaded', function () {
  var container = document.getElementById('quiz-banner-{{ section.id }}');
  if (!container) return;

  var startBtn = container.querySelector('#quiz-start-btn-{{ section.id }}');
  var intro = container.querySelector('.quiz-intro');
  var step1 = container.querySelector('.quiz-step-1');
  var step2Nodes = Array.prototype.slice.call(container.querySelectorAll('.quiz-step-2'));
  var step3Nodes = Array.prototype.slice.call(container.querySelectorAll('.quiz-step-3'));
  var reviewBox = container.querySelector('.global-review');

  function hideAllSteps() {
    if (step1) step1.style.display = 'none';
    step2Nodes.forEach(function (n) { n.style.display = 'none'; });
    step3Nodes.forEach(function (n) { n.style.display = 'none'; });
  }

  function showStep2For(pet) {
    hideAllSteps();
    var target = container.querySelector('.quiz-step-2[data-pet="' + pet + '"]');
    if (target) {
      target.style.display = 'block';
      if (reviewBox) reviewBox.style.display = 'flex';
      target.querySelector('.quiz-option')?.focus();
    } else {
      console.warn('No step2 block registered for pet:', pet);
      if (step1) step1.style.display = 'block';
    }
  }

  function showStep3For(pet) {
    hideAllSteps();
    var target = container.querySelector('.quiz-step-3[data-pet="' + pet + '"]');
    if (target) {
      target.style.display = 'block';
      if (reviewBox) reviewBox.style.display = 'flex';
      target.querySelector('.quiz-option')?.focus();
    } else {
      console.warn('No step3 block registered for pet:', pet);
    }
  }

  if (startBtn) {
    startBtn.addEventListener('click', function (e) {
      e.preventDefault();
      if (intro) intro.style.display = 'none';
      if (step1) step1.style.display = 'block';
      if (reviewBox) reviewBox.style.display = 'flex';
    });
  }

  container.addEventListener('click', function (e) {
    var opt = e.target.closest('.quiz-option');
    if (opt) {
      var parentStep = opt.closest('.quiz-step');
      if (!parentStep) return;
      parentStep.querySelectorAll('.quiz-option').forEach(function (s) {
        s.classList.remove('active');
        s.setAttribute('aria-pressed', 'false');
      });
      opt.classList.add('active');
      opt.setAttribute('aria-pressed', 'true');

      if (parentStep.classList.contains('quiz-step-1')) {
        container.dataset.selection = opt.getAttribute('data-choice'); // 'cat' or 'dog'
      } else if (parentStep.classList.contains('quiz-step-2')) {
        container.dataset.selection2 = opt.getAttribute('data-choice'); // e.g. 'dog_opt1'
      } else if (parentStep.classList.contains('quiz-step-3')) {
        container.dataset.selection3 = opt.getAttribute('data-choice'); // e.g. 'dog_opt1'
      }
      return;
    }

    var nextBtn = e.target.closest('.quiz-next');
    var backBtn = e.target.closest('.quiz-back');

    if (nextBtn) {
      if (step1 && window.getComputedStyle(step1).display !== 'none') {
        var sel = container.dataset.selection;
        if (!sel) { alert('Please choose an option to continue.'); return; }
        showStep2For(sel);
        return;
      }

      var visibleStep2 = step2Nodes.find(function (n) {
        return window.getComputedStyle(n).display !== 'none';
      });
      if (visibleStep2) {
        var chosen = container.dataset.selection2 || null;
        if (!chosen) { alert('Please choose an option to continue.'); return; }
        var pet = container.dataset.selection;
        showStep3For(pet);
        return;
      }

      var visibleStep3 = step3Nodes.find(function (n) {
        return window.getComputedStyle(n).display !== 'none';
      });
      if (visibleStep3) {
        var chosen3 = container.dataset.selection3 || null;
        if (!chosen3) { alert('Please choose an option to continue.'); return; }
        console.log("Step 3 completed. Selection3 =", chosen3);
        // You can add the next action here: e.g., show results or go to Step 4
      }

      return;
    }

    if (backBtn) {
      var visibleStep3 = step3Nodes.find(function (n) {
        return window.getComputedStyle(n).display !== 'none';
      });
      if (visibleStep3) {
        visibleStep3.style.display = 'none';
        var pet = container.dataset.selection;
        showStep2For(pet);
        return;
      }

      var visibleStep2 = step2Nodes.find(function (n) {
        return window.getComputedStyle(n).display !== 'none';
      });
      if (visibleStep2) {
        visibleStep2.style.display = 'none';
        if (step1) step1.style.display = 'block';
        return;
      }

      if (step1 && window.getComputedStyle(step1).display !== 'none') {
        step1.style.display = 'none';
        if (intro) intro.style.display = '';
        if (reviewBox) reviewBox.style.display = 'none';
      }
    }
  });
});

</script>

