<section id="quiz-banner-{{ section.id }}" class="quiz-banner-section">
  <div
    class="quiz-banner-bg quiz-intro"
    style="background-image: url('{{ section.settings.bg_image | img_url: "1600x" }}');"
  >
    <div
      class="quiz-banner-overlay"
      style="background-color: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | default: 40 | divided_by: 100 }};"
    ></div>

    <div class="quiz-banner-content">
      {% if section.settings.heading_image %}
        <img src="{{ section.settings.heading_image | img_url: '400x' }}" alt="Heading image" class="quiz-heading-img">
      {% endif %}
      <h2 class="quiz-banner-heading">{{ section.settings.heading }}</h2>

      {% if section.settings.text_image %}
        <img src="{{ section.settings.text_image | img_url: '400x' }}" alt="Text image" class="quiz-text-img">
      {% endif %}
      <p class="quiz-banner-text">{{ section.settings.text }}</p>

      <a href="#" class="quiz-banner-btn" id="quiz-start-btn-{{ section.id }}"> {{ section.settings.btn_text }} → </a>
    </div>
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'step1' %}
      <div class="quiz-step quiz-step-1" style="display:none;">
        <div class="quiz-progress" role="status" aria-live="polite">
          <span>{{ block.settings.step_label }}</span>
          <div class="quiz-progress-bar" aria-hidden="true">
            <div style="width:{{ block.settings.step_progress }}%"></div>
          </div>
          <span>{{ block.settings.step_progress }}%</span>
        </div>

        {% if section.settings.show_rating %}
          <div class="quiz-rating">
            {% for i in (1..section.settings.rating_stars) %}
              ★
            {% endfor %}
            <span class="quiz-rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}

        <h2 class="quiz-step-heading">{{ block.settings.step_heading }}</h2>
        <p class="quiz-step-subtext">{{ block.settings.step_subtext }}</p>

        <div class="quiz-options" role="list">
          <button type="button" class="quiz-option" data-choice="cat" role="listitem" aria-pressed="false">
            {% if block.settings.cat_image %}
              <img src="{{ block.settings.cat_image | img_url: '300x' }}" alt="Cat option" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.option1 }}</span>
          </button>

          <button type="button" class="quiz-option" data-choice="dog" role="listitem" aria-pressed="false">
            {% if block.settings.dog_image %}
              <img src="{{ block.settings.dog_image | img_url: '300x' }}" alt="Dog option" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.option2 }}</span>
          </button>
        </div>

        <div class="quiz-nav">
          <button type="button" class="quiz-back">{{ block.settings.back_text }}</button>
          <button type="button" class="quiz-next">{{ block.settings.next_text }}</button>
        </div>

        <div class="quiz-review" style="display:none;">
          {% if section.settings.review_image %}
            <img src="{{ section.settings.review_image | img_url: '100x' }}" alt="Review image">
          {% endif %}
          <div>
            <p>{{ section.settings.review_text }}</p>
            <strong>
              {{- section.settings.review_author }}
              <span class="verified">✔ Verified Customer</span></strong
            >
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {% for block in section.blocks %}
    {% if block.type == 'step2' %}
      <div class="quiz-step quiz-step-2" data-pet="{{ block.settings.for_pet }}" style="display:none;">
        <div class="quiz-progress" role="status" aria-live="polite">
          <span>{{ block.settings.step_label }}</span>
          <div class="quiz-progress-bar" aria-hidden="true">
            <div style="width:{{ block.settings.step_progress }}%"></div>
          </div>
          <span>{{ block.settings.step_progress }}%</span>
        </div>

        {% if section.settings.show_rating %}
          <div class="quiz-rating">
            {% for i in (1..section.settings.rating_stars) %}
              ★
            {% endfor %}
            <span class="quiz-rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}

        <h2 class="quiz-step-heading">
          {% if block.settings.for_pet == 'dog' %}
            {{ block.settings.dog_heading }}
          {% else %}
            {{ block.settings.cat_heading }}
          {% endif %}
        </h2>
        <p class="quiz-step-subtext">{{ block.settings.step_subtext }}</p>

        <div class="quiz-options" role="list">
          <button
            type="button"
            class="quiz-option"
            data-choice="{{ block.settings.for_pet }}_opt1"
            aria-pressed="false"
          >
            {% if block.settings.opt1_image %}
              <img
                src="{{ block.settings.opt1_image | img_url: '300x' }}"
                alt="{{ block.settings.opt1_label }}"
                class="quiz-option-img"
              >
            {% endif %}
            <span>{{ block.settings.opt1_label }}</span>
          </button>

          <button
            type="button"
            class="quiz-option"
            data-choice="{{ block.settings.for_pet }}_opt2"
            aria-pressed="false"
          >
            {% if block.settings.opt2_image %}
              <img
                src="{{ block.settings.opt2_image | img_url: '300x' }}"
                alt="{{ block.settings.opt2_label }}"
                class="quiz-option-img"
              >
            {% endif %}
            <span>{{ block.settings.opt2_label }}</span>
          </button>

          <button
            type="button"
            class="quiz-option"
            data-choice="{{ block.settings.for_pet }}_opt3"
            aria-pressed="false"
          >
            {% if block.settings.opt3_image %}
              <img
                src="{{ block.settings.opt3_image | img_url: '300x' }}"
                alt="{{ block.settings.opt3_label }}"
                class="quiz-option-img"
              >
            {% endif %}
            <span>{{ block.settings.opt3_label }}</span>
          </button>
        </div>

        <div class="quiz-nav">
          <button type="button" class="quiz-back">{{ block.settings.back_text }}</button>
          <button type="button" class="quiz-next">{{ block.settings.next_text }}</button>
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {%- comment -%} REVIEW box kept outside steps so we can show it once quiz starts (it remains hidden until start). {%- endcomment -%}
  <div class="quiz-review global-review" style="display:none;">
    {% if section.settings.review_image %}
      <img src="{{ section.settings.review_image | img_url: '100x' }}" alt="Review image">
    {% endif %}
    <div>
      <p>{{ section.settings.review_text }}</p>
      <strong>
        {{- section.settings.review_author }}
        <span class="verified">✔ Verified Customer</span></strong
      >
    </div>
  </div>
</section>

<style>
  .quiz-step-2 .quiz-options {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .quiz-step-2 .quiz-option {
    background:#2f86d1;
    border:none;
    border-radius:40px;
    padding:28px 26px;
    font-size:18px;
    cursor:pointer;
    transition:.18s;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:12px;
    color:#fff;
    width:220px;
    justify-content:center;
    box-shadow:none;
  }

  .quiz-step-2 .quiz-option:hover { filter: brightness(.95); }

  .quiz-step-2 .quiz-option .quiz-option-img {
    width:88px;
    height:88px;
    object-fit:cover;
    border-radius:12px;
    background:#fff;
    padding:12px;
  }

  .quiz-step-2 .quiz-option span { font-weight:700; color:#fff; }

  @media(max-width:768px){
    .quiz-step-2 .quiz-options { flex-direction: column; align-items: center; }
    .quiz-step-2 .quiz-option { width:100%; max-width:320px; border-radius:28px; }
    .quiz-step-2 .quiz-option .quiz-option-img { width:80px; height:80px; padding:10px; }
  }

  .quiz-banner-section { position: relative; width:100%; text-align:center; }
  .quiz-banner-bg { min-height:360px; display:flex; align-items:center; justify-content:center; position:relative; background-size:cover; background-position:center; }
  .quiz-banner-overlay { position:absolute; top:0; left:0; right:0; bottom:0; z-index:1; }
  .quiz-banner-content { position:relative; z-index:2; color:#fff; max-width:700px; padding:40px 20px; }
  .quiz-banner-heading { font-size:32px; font-weight:700; margin-bottom:14px; }
  .quiz-banner-text { font-size:16px; margin-bottom:22px; }
  .quiz-banner-btn { display:inline-block; background:#f2c94c; color:#000; font-weight:600; padding:14px 28px; border-radius:30px; text-decoration:none; transition:.3s; }
  .quiz-banner-btn:hover { background:#e5b93c; }

  .quiz-step { padding:40px 20px; }
  .quiz-progress { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; gap:12px; }
  .quiz-progress-bar { flex:1; height:8px; background:#eee; margin:0 10px; border-radius:4px; overflow:hidden; }
  .quiz-progress-bar div { height:100%; background:#3b82f6; }

  .quiz-rating { font-size:20px; color:#fbbf24; margin-bottom:10px; display:flex; justify-content:center; align-items:center; gap:8px; }
  .quiz-rating-text { font-size:14px; color:#444; }

  .quiz-step-heading { font-size:24px; font-weight:700; margin-bottom:8px; color:#1b4e8a; }
  .quiz-step-subtext { font-size:16px; margin-bottom:20px; color:#666; }

  .quiz-options { display:flex; justify-content:center; gap:20px; margin-bottom:20px; flex-wrap:wrap; }
  .quiz-option { background:#2f86d1; border:none; border-radius:40px; padding:28px 26px; font-size:18px; cursor:pointer; transition:.18s; display:flex; flex-direction:column; align-items:center; gap:12px; color:#fff; width:220px; justify-content:center; box-shadow:none; }
  .quiz-option:hover { filter: brightness(.95); }
  .quiz-option .quiz-option-img { width:88px; height:88px; object-fit:cover; border-radius:12px; background:#fff; padding:12px; }
  .quiz-option span { font-weight:700; color:#fff; }

  .quiz-option.inactive { background:#e0f2fe; color:#0f4b76; }
  .quiz-option.active { outline: 3px solid rgba(47,134,209,0.12); box-shadow:0 8px 20px rgba(47,134,209,0.12); }

  .quiz-nav { display:flex; justify-content:center; gap:20px; margin-bottom:20px; }
  .quiz-back, .quiz-next { padding:12px 24px; border-radius:30px; border:none; cursor:pointer; font-weight:600; }
  .quiz-back { background:#f3f4f6; color:#333; }
  .quiz-next { background:#fff; color:#0f4b76; border:2px solid #0f4b76; }

  .quiz-review { display:flex; gap:15px; max-width:800px; margin:20px auto 0; background:#f9fafb; padding:15px; border-radius:12px; text-align:left; align-items:center; }
  .quiz-review img { border-radius:50%; width:60px; height:60px; object-fit:cover; }
  .quiz-review p { margin:0 0 6px; font-size:14px; color:#333; }
  .quiz-review strong { font-size:14px; }
  .verified { color:#3b82f6; font-weight:600; }

  .quiz-heading-img, .quiz-text-img { max-width:120px; margin:0 auto 15px; display:block; }

  @media(max-width:768px){
    .quiz-banner-heading{font-size:24px;}
    .quiz-banner-text{font-size:14px;}
    .quiz-options { flex-direction:column; align-items:center; }
    .quiz-option { width:100%; max-width:320px; border-radius:28px; }
    .quiz-option .quiz-option-img { width:80px; height:80px; padding:10px; }
    .quiz-review { padding:12px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var container = document.getElementById('quiz-banner-{{ section.id }}');
    if (!container) return;

    // elements
    var startBtn = container.querySelector('#quiz-start-btn-{{ section.id }}');
    var intro = container.querySelector('.quiz-intro');
    var step1 = container.querySelector('.quiz-step-1');
    var step2Nodes = Array.prototype.slice.call(container.querySelectorAll('.quiz-step-2'));
    var reviewBox = container.querySelector('.global-review');

    // helper: hide all steps
    function hideAllSteps() {
      if (step1) step1.style.display = 'none';
      step2Nodes.forEach(function (n) {
        n.style.display = 'none';
      });
    }

    // helper: show step2 block matching pet ('cat' or 'dog')
    function showStep2For(pet) {
      hideAllSteps();
      var target = container.querySelector('.quiz-step-2[data-pet="' + pet + '"]');
      if (target) {
        target.style.display = 'block';
        if (reviewBox) reviewBox.style.display = 'flex';
      } else {
        // no matching block found (admin didn't add one) => fallback: show step1 again and log
        console.warn('No step2 block registered for pet:', pet);
        if (step1) step1.style.display = 'block';
      }
    }

    // Start button -> show step1 + review
    if (startBtn) {
      startBtn.addEventListener('click', function (e) {
        e.preventDefault();
        if (intro) intro.style.display = 'none';
        if (step1) step1.style.display = 'block';
        if (reviewBox) reviewBox.style.display = 'flex';
      });
    }

    // central click delegation for .quiz-next and .quiz-back to avoid interfering with existing handlers
    container.addEventListener('click', function (e) {
      var nextBtn = e.target.closest('.quiz-next');
      var backBtn = e.target.closest('.quiz-back');

      if (nextBtn) {
        // if currently on step1 -> navigate to step2 based on selection
        if (step1 && window.getComputedStyle(step1).display !== 'none') {
          var sel = container.dataset.selection;
          if (!sel) {
            alert('Please choose an option to continue.');
            return;
          }
          showStep2For(sel);
          return;
        }

        // if currently on a step2 -> the existing code will handle (or you can add further logic here)
        // e.g. find visible step2 and read selection
        var visibleStep2 = step2Nodes.find(function (n) {
          return window.getComputedStyle(n).display !== 'none';
        });
        if (visibleStep2) {
          var chosen = container.dataset.selection2 || null;
          // If you want to require a selection on step2, check here and show alert if none.
          // For now we'll log and let you wire the next actions.
          console.log('Step 2 Next clicked. (You can wire step 3 here.)');
        }
        return;
      }

      if (backBtn) {
        // if on a step2 -> go back to step1
        var visibleStep2 = step2Nodes.find(function (n) {
          return window.getComputedStyle(n).display !== 'none';
        });
        if (visibleStep2) {
          visibleStep2.style.display = 'none';
          if (step1) step1.style.display = 'block';
          return;
        }
        // else if on step1 -> original behavior (intro + hide review)
        if (step1 && window.getComputedStyle(step1).display !== 'none') {
          if (step1) step1.style.display = 'none';
          if (intro) intro.style.display = '';
          if (reviewBox) reviewBox.style.display = 'none';
        }
        return;
      }
    });

    // option clicks: mark active and store selection.
    // We support two levels of selection:
    //  - Step1 selections store in dataset.selection (cat/dog)
    //  - Step2 selections store in dataset.selection2 (e.g. cat_opt1 / dog_opt2)
    container.addEventListener('click', function (e) {
      var opt = e.target.closest('.quiz-option');
      if (!opt) return;

      // determine which visible step this option belongs to
      var parentStep = opt.closest('.quiz-step');
      if (!parentStep) return;

      // clear actives inside that step only
      var siblings = parentStep.querySelectorAll('.quiz-option');
      siblings.forEach(function (s) {
        s.classList.remove('active');
        s.setAttribute('aria-pressed', 'false');
      });

      opt.classList.add('active');
      opt.setAttribute('aria-pressed', 'true');

      // if parent is step1 -> store container.dataset.selection
      if (parentStep.classList.contains('quiz-step-1')) {
        container.dataset.selection = opt.getAttribute('data-choice');
      } else if (parentStep.classList.contains('quiz-step-2')) {
        // store second-level selection
        container.dataset.selection2 = opt.getAttribute('data-choice');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Quiz Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#000000" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    },
    { "type": "image_picker", "id": "heading_image", "label": "Optional Heading Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find The Perfect Nutram Recipe In 30 Seconds" },
    { "type": "image_picker", "id": "text_image", "label": "Optional Text Image" },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext",
      "default": "Answer a few quick questions, get a custom dry-food plan and 10% off your first bag."
