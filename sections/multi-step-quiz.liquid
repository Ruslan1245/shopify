<section id="quiz-banner-{{ section.id }}" class="quiz-banner-section">
  <div class="quiz-banner-bg quiz-intro"
       style="background-image: url('{{ section.settings.bg_image | img_url: "1600x" }}');">
    <div class="quiz-banner-overlay"
         style="background-color: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | default: 40 | divided_by: 100 }};">
    </div>

    <div class="quiz-banner-content">
      {% if section.settings.heading_image %}
        <img src="{{ section.settings.heading_image | img_url: '400x' }}" alt="Heading image" class="quiz-heading-img">
      {% endif %}
      <h2 class="quiz-banner-heading">{{ section.settings.heading }}</h2>

      {% if section.settings.text_image %}
        <img src="{{ section.settings.text_image | img_url: '400x' }}" alt="Text image" class="quiz-text-img">
      {% endif %}
      <p class="quiz-banner-text">{{ section.settings.text }}</p>

      <a href="#" class="quiz-banner-btn" id="quiz-start-btn-{{ section.id }}">
        {{ section.settings.btn_text }} →
      </a>
    </div>
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'step1' %}
      <div class="quiz-step quiz-step-1" style="display:none;">
        <div class="quiz-progress">
          <span>{{ block.settings.step_label }}</span>
          <div class="quiz-progress-bar"><div style="width:{{ block.settings.step_progress }}%"></div></div>
          <span>{{ block.settings.step_progress }}%</span>
        </div>

        {% if section.settings.show_rating %}
          <div class="quiz-rating">
            {% for i in (1..section.settings.rating_stars) %}★{% endfor %}
            <span class="quiz-rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}

        <h2 class="quiz-step-heading">{{ block.settings.step_heading }}</h2>
        <p class="quiz-step-subtext">{{ block.settings.step_subtext }}</p>

        <div class="quiz-options">
          <button type="button" class="quiz-option" data-choice="cat">
            {% if block.settings.cat_image %}
              <img src="{{ block.settings.cat_image | img_url: '300x' }}" alt="Cat" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.option1 }}</span>
          </button>

          <button type="button" class="quiz-option" data-choice="dog">
            {% if block.settings.dog_image %}
              <img src="{{ block.settings.dog_image | img_url: '300x' }}" alt="Dog" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.option2 }}</span>
          </button>
        </div>

        <div class="quiz-nav">
          <button type="button" class="quiz-back">{{ block.settings.back_text }}</button>
          <button type="button" class="quiz-next">{{ block.settings.next_text }}</button>
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {% for block in section.blocks %}
    {% if block.type == 'step2' %}
      <div class="quiz-step quiz-step-2" data-pet="{{ block.settings.for_pet }}" style="display:none;">
        <div class="quiz-progress">
          <span>{{ block.settings.step_label }}</span>
          <div class="quiz-progress-bar"><div style="width:{{ block.settings.step_progress }}%"></div></div>
          <span>{{ block.settings.step_progress }}%</span>
        </div>

        {% if section.settings.show_rating %}
          <div class="quiz-rating">
            {% for i in (1..section.settings.rating_stars) %}★{% endfor %}
            <span class="quiz-rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}

        <h2 class="quiz-step-heading">{{ block.settings.step_heading }}</h2>
        <p class="quiz-step-subtext">{{ block.settings.step_subtext }}</p>

        <div class="quiz-options">
          <button type="button" class="quiz-option" data-choice="{{ block.settings.for_pet }}_opt1">
            {% if block.settings.opt1_image %}
              <img src="{{ block.settings.opt1_image | img_url: '300x' }}" alt="{{ block.settings.opt1_label }}" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.opt1_label }}</span>
          </button>

          <button type="button" class="quiz-option" data-choice="{{ block.settings.for_pet }}_opt2">
            {% if block.settings.opt2_image %}
              <img src="{{ block.settings.opt2_image | img_url: '300x' }}" alt="{{ block.settings.opt2_label }}" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.opt2_label }}</span>
          </button>

          <button type="button" class="quiz-option" data-choice="{{ block.settings.for_pet }}_opt3">
            {% if block.settings.opt3_image %}
              <img src="{{ block.settings.opt3_image | img_url: '300x' }}" alt="{{ block.settings.opt3_label }}" class="quiz-option-img">
            {% endif %}
            <span>{{ block.settings.opt3_label }}</span>
          </button>
        </div>

        <div class="quiz-nav">
          <button type="button" class="quiz-back">{{ block.settings.back_text }}</button>
          <button type="button" class="quiz-next">{{ block.settings.next_text }}</button>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</section>

<script>
document.addEventListener("DOMContentLoaded", function(){
  var container = document.getElementById("quiz-banner-{{ section.id }}");
  var intro = container.querySelector(".quiz-intro");
  var step1 = container.querySelector(".quiz-step-1");
  var step2Blocks = container.querySelectorAll(".quiz-step-2");

  var startBtn = container.querySelector("#quiz-start-btn-{{ section.id }}");

  // Start -> show Step 1
  startBtn.addEventListener("click", function(e){
    e.preventDefault();
    intro.style.display = "none";
    step1.style.display = "block";
  });

  // Select pet
  container.addEventListener("click", function(e){
    var opt = e.target.closest(".quiz-option");
    if(opt && opt.closest(".quiz-step-1")){
      container.dataset.pet = opt.dataset.choice; // save cat or dog
      step1.querySelectorAll(".quiz-option").forEach(o=>o.classList.remove("active"));
      opt.classList.add("active");
    }
  });

  // Next button logic
  container.addEventListener("click", function(e){
    var nextBtn = e.target.closest(".quiz-next");
    if(!nextBtn) return;

    if(step1.style.display !== "none"){ // From Step 1
      if(!container.dataset.pet){
        alert("Please select Cat or Dog first.");
        return;
      }
      step1.style.display = "none";
      step2Blocks.forEach(block=>{
        block.style.display = block.dataset.pet === container.dataset.pet ? "block" : "none";
      });
    }
  });

  // Back button logic
  container.addEventListener("click", function(e){
    var backBtn = e.target.closest(".quiz-back");
    if(!backBtn) return;

    var visibleStep2 = [...step2Blocks].find(b=>b.style.display==="block");
    if(visibleStep2){ // from Step 2 back to Step 1
      visibleStep2.style.display = "none";
      step1.style.display = "block";
    } else { // from Step 1 back to intro
      step1.style.display = "none";
      intro.style.display = "block";
    }
  });
});
</script>
