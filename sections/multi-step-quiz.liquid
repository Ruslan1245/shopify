{% comment %}
Quiz Banner Intro Section
File: sections/quiz-banner.liquid
{% endcomment %}

<section id="quiz-banner-{{ section.id }}" class="quiz-banner-section">
  <div class="quiz-banner-bg" 
       style="background-image:url({{ section.settings.bg_image | img_url: '1600x' }});">
    <div class="quiz-banner-overlay" 
         style="background-color:{{ section.settings.overlay_color }}; opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};">
    </div>
    <div class="quiz-banner-content">
      <h2 class="quiz-banner-heading">{{ section.settings.heading }}</h2>
      <p class="quiz-banner-text">{{ section.settings.text }}</p>
      <a href="javascript:void(0);" class="quiz-banner-btn" id="quiz-start-btn">
        {{ section.settings.btn_text }} →
      </a>
    </div>
  </div>
</section>

<style>
  .quiz-banner-section {
    position: relative;
    width: 100%;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .quiz-banner-bg {
    position: relative;
    width: 100%;
    min-height: 360px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quiz-banner-overlay {
    position: absolute;
    top:0; left:0; right:0; bottom:0;
  }
  .quiz-banner-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
    padding: 40px 20px;
    color: #fff;
  }
  .quiz-banner-heading {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .quiz-banner-text {
    font-size: 16px;
    margin-bottom: 22px;
  }
  .quiz-banner-btn {
    display: inline-block;
    background: #f2c94c;
    color: #000;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: 30px;
    text-decoration: none;
    transition: background .3s ease;
  }
  .quiz-banner-btn:hover {
    background: #e5b93c;
  }

  @media(max-width:768px){
    .quiz-banner-heading{font-size:24px;}
    .quiz-banner-text{font-size:14px;}
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function(){
    var startBtn = document.getElementById("quiz-start-btn");
    if(startBtn){
      startBtn.addEventListener("click", function(){
        // Later: open quiz steps (replace this with your quiz logic)
        alert("Quiz will start...");
      });
    }
  });
</script>

{% schema %}
{
  "name": "Quiz Banner Intro",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find The Perfect Nutram Recipe In 30 Seconds"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext",
      "default": "Answer a few quick questions, get a custom dry-food plan and 10% off your first bag."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Start Quiz"
    }
  ],
  "presets": [
    {
      "name": "Quiz Banner Intro"
    }
  ]
}
{% endschema %}
