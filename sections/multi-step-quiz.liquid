  { "type": "image_picker", "id": "dog_opt3_image", "label": "Option 3 Image" },
  { "type": "text", "id": "dog_back_text", "label": "Back Button Text", "default": "← Go Back" },
  { "type": "text", "id": "dog_next_text", "label": "Next Button Text", "default": "Next →" },

  {
    "type": "header",
