{% comment %}
Quiz Banner with Step 1 (checked + scoped)
File: sections/quiz-banner.liquid
{% endcomment %}

<section id="quiz-banner-{{ section.id }}" class="quiz-banner-section">
  <!-- Intro Section -->
  <div class="quiz-banner-bg quiz-intro"
       style="background-image: url('{{ section.settings.bg_image | img_url: "1600x" }}');">
    <div class="quiz-banner-overlay"
         style="background-color: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | default: 40 | divided_by: 100 }};">
    </div>

    <div class="quiz-banner-content">
      <h2 class="quiz-banner-heading">{{ section.settings.heading }}</h2>
      <p class="quiz-banner-text">{{ section.settings.text }}</p>
      <a href="#" class="quiz-banner-btn" id="quiz-start-btn-{{ section.id }}">
        {{ section.settings.btn_text }} →
      </a>
    </div>
  </div>

  <!-- Step 1 (hidden initially) -->
  <div class="quiz-step quiz-step-1" style="display:none;">
    <div class="quiz-progress" role="status" aria-live="polite">
      <span>Step 1</span>
      <div class="quiz-progress-bar" aria-hidden="true"><div style="width:40%"></div></div>
      <span>40%</span>
    </div>

    <h2 class="quiz-step-heading">Who Are We Feeding Today?</h2>
    <p class="quiz-step-subtext">Choose one as you want.</p>

    <div class="quiz-options" role="list">
      <button type="button" class="quiz-option" data-choice="cat" role="listitem" aria-pressed="false">
        <span class="quiz-icon" aria-hidden="true">🐱</span>
        <span>Cat</span>
      </button>

      <button type="button" class="quiz-option" data-choice="dog" role="listitem" aria-pressed="false">
        <span class="quiz-icon" aria-hidden="true">🐶</span>
        <span>Dog</span>
      </button>
    </div>

    <div class="quiz-nav">
      <button type="button" class="quiz-back">← Go Back</button>
      <button type="button" class="quiz-next">Next →</button>
    </div>

    <div class="quiz-review">
      <img src="https://via.placeholder.com/60" alt="Review image">
      <div>
        <p>"After switching, Max’s coat is shinier and tummy trouble disappeared in two weeks!"</p>
        <strong>John D. <span class="verified">✔ Verified Customer</span></strong>
      </div>
    </div>
  </div>
</section>

<style>
/* General */
.quiz-banner-section { position: relative; width:100%; text-align:center; }
.quiz-banner-bg { min-height:360px; display:flex; align-items:center; justify-content:center; position:relative; background-size:cover; background-position:center; }
.quiz-banner-overlay { position:absolute; top:0; left:0; right:0; bottom:0; z-index:1; }
.quiz-banner-content { position:relative; z-index:2; color:#fff; max-width:700px; padding:40px 20px; }
.quiz-banner-heading { font-size:32px; font-weight:700; margin-bottom:14px; }
.quiz-banner-text { font-size:16px; margin-bottom:22px; }
.quiz-banner-btn { display:inline-block; background:#f2c94c; color:#000; font-weight:600; padding:14px 28px; border-radius:30px; text-decoration:none; transition:.3s; }
.quiz-banner-btn:hover { background:#e5b93c; }

/* Step 1 */
.quiz-step { padding:40px 20px; }
.quiz-progress { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; gap:12px; }
.quiz-progress-bar { flex:1; height:8px; background:#eee; margin:0 10px; border-radius:4px; overflow:hidden; }
.quiz-progress-bar div { height:100%; background:#3b82f6; }
.quiz-step-heading { font-size:24px; font-weight:700; margin-bottom:8px; color:#1b4e8a; }
.quiz-step-subtext { font-size:16px; margin-bottom:20px; color:#666; }
.quiz-options { display:flex; justify-content:center; gap:20px; margin-bottom:20px; }
.quiz-option { background:#e0f2fe; border:none; border-radius:20px; padding:30px 40px; font-size:18px; cursor:pointer; transition:.18s; display:flex; flex-direction:column; align-items:center; gap:8px; color:#0f4b76; }
.quiz-option:hover { background:#bae6fd; }
.quiz-option.active { background:#2f86d1; color:#fff; }
.quiz-icon { font-size:32px; }
.quiz-nav { display:flex; justify-content:center; gap:20px; margin-bottom:20px; }
.quiz-back, .quiz-next { padding:12px 24px; border-radius:30px; border:none; cursor:pointer; font-weight:600; }
.quiz-back { background:#f3f4f6; }
.quiz-next { background:#000; color:#fff; }
.quiz-review { display:flex; gap:15px; max-width:600px; margin:0 auto; background:#f9fafb; padding:15px; border-radius:12px; text-align:left; }
.quiz-review img { border-radius:50%; width:60px; height:60px; object-fit:cover; }
.quiz-review p { margin:0 0 6px; font-size:14px; color:#333; }
.quiz-review strong { font-size:14px; }
.verified { color:#3b82f6; font-weight:600; }

@media(max-width:768px){
  .quiz-banner-heading{font-size:24px;}
  .quiz-banner-text{font-size:14px;}
  .quiz-options { flex-direction:column; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){
  var container = document.getElementById('quiz-banner-{{ section.id }}');
  if(!container) return;

  var startBtn = container.querySelector('#quiz-start-btn-{{ section.id }}');
  var intro = container.querySelector('.quiz-intro');
  var step1 = container.querySelector('.quiz-step-1');
  var backBtn = container.querySelector('.quiz-back');
  var nextBtn = container.querySelector('.quiz-next');
  var options = container.querySelectorAll('.quiz-option');

  // Start -> show step1
  if(startBtn){
    startBtn.addEventListener('click', function(e){
      e.preventDefault();
      if(intro) intro.style.display = 'none';
      if(step1) step1.style.display = 'block';
      startBtn.blur();
      // dispatch a namespaced event you can hook: 'quiz:intro-started'
      container.dispatchEvent(new CustomEvent('quiz:intro-started', { bubbles: true, detail: { sectionId: '{{ section.id }}' } }));
    });
  }

  // Back -> return to intro
  if(backBtn){
    backBtn.addEventListener('click', function(){
      if(step1) step1.style.display = 'none';
      if(intro) intro.style.display = '';
      container.dispatchEvent(new CustomEvent('quiz:back', { bubbles: true, detail: { sectionId: '{{ section.id }}' } }));
    });
  }

  // Options selection
  options.forEach(function(opt){
    opt.addEventListener('click', function(){
      options.forEach(function(o){ o.classList.remove('active'); o.setAttribute('aria-pressed', 'false'); });
      this.classList.add('active');
      this.setAttribute('aria-pressed', 'true');
      // store selection on container for later use
      container.dataset.selection = this.getAttribute('data-choice');
      // optional: dispatch choice event
      container.dispatchEvent(new CustomEvent('quiz:choice', { bubbles:true, detail: { sectionId:'{{ section.id }}', choice: container.dataset.selection } }));
    });
  });

  // Next -> require a selection, then dispatch event for next action
  if(nextBtn){
    nextBtn.addEventListener('click', function(){
      var selected = container.dataset.selection;
      if(!selected){
        // simple lightweight feedback (non-blocking)
        if (window.alert) { alert('Please choose an option to continue.'); }
        return;
      }
      container.dispatchEvent(new CustomEvent('quiz:next', { bubbles:true, detail: { sectionId:'{{ section.id }}', choice: selected } }));
      console.log('quiz:next fired for section {{ section.id }} with choice:', selected);
      // you can add navigation here (e.g. show Step 2)
    });
  }
});
</script>

{% schema %}
{
  "name": "Quiz Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find The Perfect Nutram Recipe In 30 Seconds"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext",
      "default": "Answer a few quick questions, get a custom dry-food plan and 10% off your first bag."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Start Quiz"
    }
  ],
  "presets": [
    {
      "name": "Quiz Banner"
    }
  ]
}
{% endschema %}
