{% comment %}
Quiz Banner with Step 1
File: sections/quiz-banner.liquid
{% endcomment %}

<section id="quiz-banner-{{ section.id }}" class="quiz-banner-section">
  <!-- Intro Section -->
  <div class="quiz-banner-bg quiz-intro" 
       style="background-image:url({{ section.settings.bg_image | img_url: '1600x' }});">
    <div class="quiz-banner-overlay" 
         style="background-color:{{ section.settings.overlay_color }}; opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};">
    </div>
    <div class="quiz-banner-content">
      <h2 class="quiz-banner-heading">{{ section.settings.heading }}</h2>
      <p class="quiz-banner-text">{{ section.settings.text }}</p>
      <a href="javascript:void(0);" class="quiz-banner-btn" id="quiz-start-btn">
        {{ section.settings.btn_text }} →
      </a>
    </div>
  </div>

  <!-- Step 1 -->
  <div class="quiz-step quiz-step-1" style="display:none;">
    <div class="quiz-progress">
      <span>Step 1</span>
      <div class="quiz-progress-bar"><div style="width:40%"></div></div>
      <span>40%</span>
    </div>

    <h2 class="quiz-step-heading">Who Are We Feeding Today?</h2>
    <p class="quiz-step-subtext">Choose one as you want.</p>

    <div class="quiz-options">
      <button class="quiz-option" data-choice="cat">
        <span class="quiz-icon">🐱</span>
        <span>Cat</span>
      </button>
      <button class="quiz-option" data-choice="dog">
        <span class="quiz-icon">🐶</span>
        <span>Dog</span>
      </button>
    </div>

    <div class="quiz-nav">
      <button class="quiz-back">← Go Back</button>
      <button class="quiz-next">Next →</button>
    </div>

    <div class="quiz-review">
      <img src="https://via.placeholder.com/60" alt="Review image">
      <div>
        <p>"After switching, Max’s coat is shinier and tummy trouble disappeared in two weeks!"</p>
        <strong>John D. <span class="verified">✔ Verified Customer</span></strong>
      </div>
    </div>
  </div>
</section>

<style>
/* General */
.quiz-banner-section { position: relative; width:100%; text-align:center; }
.quiz-banner-bg { min-height:360px; display:flex; align-items:center; justify-content:center; }
.quiz-banner-overlay { position:absolute; top:0; left:0; right:0; bottom:0; }
.quiz-banner-content { position:relative; z-index:2; color:#fff; max-width:700px; padding:40px 20px; }
.quiz-banner-heading { font-size:32px; font-weight:700; margin-bottom:14px; }
.quiz-banner-text { font-size:16px; margin-bottom:22px; }
.quiz-banner-btn { display:inline-block; background:#f2c94c; color:#000; font-weight:600; padding:14px 28px; border-radius:30px; text-decoration:none; transition:.3s; }
.quiz-banner-btn:hover { background:#e5b93c; }

/* Step 1 */
.quiz-step { padding:40px 20px; }
.quiz-progress { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
.quiz-progress-bar { flex:1; height:8px; background:#eee; margin:0 10px; border-radius:4px; overflow:hidden; }
.quiz-progress-bar div { height:100%; background:#3b82f6; }
.quiz-step-heading { font-size:24px; font-weight:700; margin-bottom:8px; }
.quiz-step-subtext { font-size:16px; margin-bottom:20px; color:#666; }
.quiz-options { display:flex; justify-content:center; gap:20px; margin-bottom:20px; }
.quiz-option { background:#e0f2fe; border:none; border-radius:20px; padding:30px 40px; font-size:18px; cursor:pointer; transition:.3s; display:flex; flex-direction:column; align-items:center; gap:8px; }
.quiz-option:hover { background:#bae6fd; }
.quiz-icon { font-size:32px; }
.quiz-nav { display:flex; justify-content:center; gap:20px; margin-bottom:20px; }
.quiz-back, .quiz-next { padding:12px 24px; border-radius:30px; border:none; cursor:pointer; font-weight:600; }
.quiz-back { background:#f3f4f6; }
.quiz-next { background:#000; color:#fff; }
.quiz-review { display:flex; gap:15px; max-width:600px; margin:0 auto; background:#f9fafb; padding:15px; border-radius:12px; text-align:left; }
.quiz-review img { border-radius:50%; }
.quiz-review p { margin:0 0 6px; font-size:14px; color:#333; }
.quiz-review strong { font-size:14px; }
.verified { color:#3b82f6; font-weight:600; }

@media(max-width:768px){
  .quiz-banner-heading{font-size:24px;}
  .quiz-banner-text{font-size:14px;}
  .quiz-options { flex-direction:column; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){
  var startBtn = document.getElementById("quiz-start-btn");
  var intro = document.querySelector(".quiz-intro");
  var step1 = document.querySelector(".quiz-step-1");

  if(startBtn){
    startBtn.addEventListener("click", function(){
      intro.style.display = "none";
      step1.style.display = "block";
    });
  }
});
</script>

{% schema %}
{
  "name": "Quiz Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find The Perfect Nutram Recipe In 30 Seconds"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext",
      "default": "Answer a few quick questions, get a custom dry-food plan and 10% off your first bag."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Start Quiz"
    }
  ],
  "presets": [
    {
      "name": "Quiz Banner"
    }
  ]
}
{% endschema %}
