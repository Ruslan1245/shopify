    },
    {
      "type": "step2",
      "name": "Step 2 (Cat or Dog)",
      "settings": [
  {
    "type": "header",
    "content": "For Dogs"
  },
  { "type": "text", "id": "dog_step_label", "label": "Step Label", "default": "Step 2" },
  { "type": "range", "id": "dog_step_progress", "label": "Progress %", "min": 0, "max": 100, "default": 65 },
