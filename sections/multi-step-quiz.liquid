<section id="quiz-banner-{{ section.id }}" class="quiz-banner-section">
  <div
    class="quiz-banner-bg quiz-intro"
    style="background-image: url('{{ section.settings.bg_image | img_url: "1600x" }}');"
  >
    <div
      class="quiz-banner-overlay"
      style="background-color: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | default: 40 | divided_by: 100 }};"
    ></div>

    <div class="quiz-banner-content">
      {% if section.settings.heading_image %}
        <img src="{{ section.settings.heading_image | img_url: '400x' }}" alt="Heading image" class="quiz-heading-img">
      {% endif %}
      <h2 class="quiz-banner-heading">{{ section.settings.heading }}</h2>

      {% if section.settings.text_image %}
        <img src="{{ section.settings.text_image | img_url: '400x' }}" alt="Text image" class="quiz-text-img">
      {% endif %}
      <p class="quiz-banner-text">{{ section.settings.text }}</p>

      <a href="#" class="quiz-banner-btn" id="quiz-start-btn-{{ section.id }}"> {{ section.settings.btn_text }} </a>
    </div>
  </div>

  {%- comment -%} STEP 1 block(s) - only one expected {%- endcomment -%}
  {% for block in section.blocks %}
    {% if block.type == 'step1' %}
      <div class="quiz-step quiz-step-1" style="display:none;">
        

        {% if section.settings.show_rating %}
          <div class="quiz-rating">
            {% for i in (1..section.settings.rating_stars) %}★{% endfor %}
            <span class="quiz-rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}

        <div class="quiz-progress" role="status" aria-live="polite">
          <span>{{ block.settings.step_label }}</span>
          <div class="quiz-progress-bar" aria-hidden="true">
            <div style="width:{{ block.settings.step_progress }}%"></div>
          </div>
          <span>{{ block.settings.step_progress }}%</span>
        </div>

        <h2 class="quiz-step-heading">{{ block.settings.step_heading }}</h2>
        <p class="quiz-step-subtext">{{ block.settings.step_subtext }}</p>

        <div class="quiz-options" role="list">
          <button type="button" class="quiz-option" data-choice="cat" role="listitem" aria-pressed="false">
            {% if block.settings.cat_image %}
              <img src="{{ block.settings.cat_image | img_url: '300x' }}" alt="Cat option" class="quiz-option-img">
              
            {% endif %}
            <img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/outline.png?v=1757785070">
            <span>{{ block.settings.option1 }}</span>
          </button>

          <button type="button" class="quiz-option" data-choice="dog" role="listitem" aria-pressed="false">
            {% if block.settings.dog_image %}
              <img src="{{ block.settings.dog_image | img_url: '300x' }}" alt="Dog option" class="quiz-option-img">
            {% endif %}
            <img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/pets_12452249_1.png?v=1757785069">
            
            <span>{{ block.settings.option2 }}</span>
          </button>
        </div>

        <div class="quiz-nav">
          <button type="button" class="quiz-back">{{ block.settings.back_text }}</button>
          <button type="button" class="quiz-next">{{ block.settings.next_text }}</button>
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {%- comment -%}
    STEP 2: render one panel per pet using prefixed settings (dog_*, cat_*)
    This assumes step2 block exists (we render the block's dog_/cat_ settings).
  {%- endcomment -%}
  {% for block in section.blocks %}
  {% if block.type == 'step2' %}
    {% assign pets = "dog,cat" | split: "," %}
    {% for pet in pets %}
      {% assign step_label_key = pet | append: '_step_label' %}
      {% assign step_progress_key = pet | append: '_step_progress' %}
      {% assign heading_key = pet | append: '_heading' %}
      {% assign subtext_key = pet | append: '_step_subtext' %}
      {% assign back_text_key = pet | append: '_back_text' %}
      {% assign next_text_key = pet | append: '_next_text' %}

      <div class="quiz-step quiz-step-2" data-pet="{{ pet }}" style="display:none;">
        

        {% if section.settings.show_rating %}
          <div class="quiz-rating">
            {% for i in (1..section.settings.rating_stars) %}★{% endfor %}
            <span class="quiz-rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}

        <div class="quiz-progress" role="status" aria-live="polite">
          <span>{{ block.settings[step_label_key] }}</span>
          <div class="quiz-progress-bar" aria-hidden="true">
            <div style="width:{{ block.settings[step_progress_key] }}%"></div>
          </div>
          <span>{{ block.settings[step_progress_key] }}%</span>
        </div>

        <h2 class="quiz-step-heading">{{ block.settings[heading_key] }}</h2>
        <p class="quiz-step-subtext">{{ block.settings[subtext_key] }}</p>

        <div class="quiz-options" role="list">
          {% for i in (1..3) %}
            {% assign opt_label_key = pet | append: '_opt' | append: i | append: '_label' %}
            {% assign opt_image_key = pet | append: '_opt' | append: i | append: '_image' %}
            <button
              type="button"
              class="quiz-option"
              data-choice="{{ pet }}_opt{{ i }}"
              aria-pressed="false"
            >
              {% if block.settings[opt_image_key] %}
                <img src="{{ block.settings[opt_image_key] | img_url: '88x88' }}" alt="{{ block.settings[opt_label_key] }}" class="quiz-option-img">
              {% endif %}
              <span>{{ block.settings[opt_label_key] }}</span>
            </button>
          {% endfor %}
        </div>

        <div class="quiz-nav">
          <button type="button" class="quiz-back">{{ block.settings[back_text_key] }}</button>
          <button type="button" class="quiz-next">{{ block.settings[next_text_key] }}</button>
        </div>
      </div>
    {% endfor %}
  {% endif %}
{% endfor %}

{% for block in section.blocks %}
    {% if block.type == 'step3' %}
      {% assign pets = "dog,cat" | split: "," %}
      {% for pet in pets %}
        {% assign step_label_key = pet | append: '_step3_label' %}
        {% assign step_progress_key = pet | append: '_step3_progress' %}
        {% assign heading_key = pet | append: '_step3_heading' %}
        {% assign subtext_key = pet | append: '_step3_subtext' %}
        {% assign back_text_key = pet | append: '_step3_back_text' %}
        {% assign next_text_key = pet | append: '_step3_next_text' %}

        <div class="quiz-step quiz-step-3" data-pet="{{ pet }}" style="display:none;">
          

          {% if section.settings.show_rating %}
            <div class="quiz-rating">
              {% for i in (1..section.settings.rating_stars) %}★{% endfor %}
              <span class="quiz-rating-text">{{ section.settings.rating_text }}</span>
            </div>
          {% endif %}

          <div class="quiz-progress" role="status" aria-live="polite">
            <span>{{ block.settings[step_label_key] }}</span>
            <div class="quiz-progress-bar" aria-hidden="true">
              <div style="width:{{ block.settings[step_progress_key] }}%"></div>
            </div>
            <span>{{ block.settings[step_progress_key] }}%</span>
          </div>

          <h2 class="quiz-step-heading">{{ block.settings[heading_key] }}</h2>
          <p class="quiz-step-subtext">{{ block.settings[subtext_key] }}</p>

          <div class="quiz-options" role="list">
            {% for i in (1..3) %}
              {% assign opt_label_key = pet | append: '_step3_opt' | append: i | append: '_label' %}
              {% assign opt_image_key = pet | append: '_step3_opt' | append: i | append: '_image' %}
              <button
                type="button"
                class="quiz-option"
                data-choice="{{ pet }}_step3_opt{{ i }}"
                aria-pressed="false"
              >
                {% if block.settings[opt_image_key] %}
                  <img src="{{ block.settings[opt_image_key] | img_url: '88x88' }}"
                       alt="{{ block.settings[opt_label_key] }}"
                       class="quiz-option-img">
                {% endif %}
                <span>{{ block.settings[opt_label_key] }}</span>
              </button>
            {% endfor %}
          </div>

          <div class="quiz-nav">
            <button type="button" class="quiz-back">{{ block.settings[back_text_key] }}</button>
            <button type="button" class="quiz-next">{{ block.settings[next_text_key] }}</button>
          </div>
        </div>

      {% endfor %}
    {% endif %}
  {% endfor %}



  {%- comment -%} REVIEW box kept outside steps so we can show it once quiz starts (it remains hidden until start). {%- endcomment -%}
  <div class="quiz-review global-review" style="display:none;">
    {% if section.settings.review_image %}
      <img src="{{ section.settings.review_image | img_url: '100x' }}" alt="Review image">
    {% endif %}
    <div>
      <p>{{ section.settings.review_text }}</p>
      <strong>
        {{- section.settings.review_author }}
        <span class="verified"> Verified Customer</span>
      </strong>
    </div>
  </div>
</section>

