{% comment %}
  Section: quiz-result
  Displays personalized product recommendation after quiz.
  - If ?product_id= is in URL → use mapped product
  - Else → use selected fallback product from section settings
{% endcomment %}
{% style %}
  .quiz-add-to-cart, .alt-actions button {
    background-color: #ffc107;
    color: #353535;
    font-weight: 600;
    padding: .75rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    width: 100%;
    font-size: 17px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 1rem;
}
.quiz-find-retailer, .bundle-ctas a{
    font-weight: 600;
    padding: .75rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    width: 100%;
    font-size: 17px;
    position: relative;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    padding-right: 1.5rem;
}

.quiz-add-to-cart::after, .quiz-find-retailer::after, .alt-actions button::after {
    content: "";
    background-image: url('/cdn/shop/files/Vector_5c1622c0-29e6-402a-a815-8da37656e4fc.png?v=1755184216');
    height: 15px;
    width: 15px;
    background-repeat: no-repeat;
    background-size: contain;
}

.quiz-find-retailer::after, .bundle-ctas a::after {
    content: "";
    background-image: url('/cdn/shop/files/Vector_914f7b28-0d65-42ec-8a4f-a4f16f0ada9a.png?v=1755190591');
    height: 15px;
    width: 15px;
    background-repeat: no-repeat;
    background-size: contain;
}
.quiz-top-rating span {
    display: flex;
    justify-content: center;
    align-items: center;
    column-gap: 6px;
}
.quiz-top-rating img {
    height: auto;
    width: 83px;
}
.quiz-stars span {
    display: flex;
    align-items: center;
    column-gap: 5px;
    font-family: Outfit;
    font-weight: 400;
    font-size: 14px;
    line-height: 120%;
    vertical-align: middle;
    color: #353535;
}
.quiz-stars span img {
    width: 73px;
    height: auto;
}
{% endstyle %}


{% assign query_id = request.params.product_id %}
{% assign product_handle = blank %}

{%- if query_id != blank -%}
  {%- for block in section.blocks -%}
    {% if block.type == "product_map" and block.settings.product_id == query_id %}
      {% assign product_handle = block.settings.product_handle %}
    {% endif %}
  {%- endfor -%}
{%- endif -%}

{% if product_handle == blank %}
  {% assign quiz_product = all_products[section.settings.default_product] %}
{% else %}
  {% assign quiz_product = all_products[product_handle] %}
{% endif %}

<div class="quiz-result-wrapper">
  <div class="quiz-top-rating">
    {% comment %} ⭐⭐⭐⭐⭐  {% endcomment %}
     <span><img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Group_55.png?v=1758037849">{{ section.settings.top_rating_text }}</span>
  </div>

  <h2 class="quiz-result-heading" id="quizHeading">
    Here’s <span id="quizPetName"></span>’s {{ section.settings.heading_text }}
  </h2>

  <div class="quiz-result-content">
    <!-- Left -->
    <div class="quiz-result-text">
      <div class="inner-left">
      <div class="quiz-stars">
        {% comment %} ⭐⭐⭐⭐⭐ {% endcomment %}
        <span><img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Group_55.png?v=1758037849">{{ section.settings.review_text }}</span></div>

      {% if quiz_product %}
        <h3 class="quiz-product-title">{{ quiz_product.title }}</h3>
        <p class="quiz-product-subtitle">Chicken and Turkey Recipe</p>
        <p class="quiz-product-price">From {{ quiz_product.price_min | money }}</p>
      {% else %}
        <p>No product found for this quiz result.</p>
      {% endif %}

      <ul class="quiz-bullets">
        <li>{{ section.settings.bullet_1 }}</li>
        <li>{{ section.settings.bullet_2 }}</li>
        <li>{{ section.settings.bullet_3 }}</li>
      </ul>

      {% if quiz_product %}
      <div class="quiz-buttons">
        <form method="post" action="/cart/add">
          <input type="hidden" name="id" value="{{ quiz_product.first_available_variant.id }}">
          <button type="submit" class="quiz-add-to-cart">
            {{ section.settings.add_to_cart_text }}
          </button>
        </form>
        {% if section.settings.retailer_url != blank %}
          <a href="{{ section.settings.retailer_url }}" class="quiz-find-retailer">
            {{ section.settings.retailer_text }}
          </a>
        {% endif %}
      </div>
      {% endif %}

      <div class="quiz-customer-review">
        {% if section.settings.author_image != blank %}
        <div class="quiz__author-img">
          <img src="{{ section.settings.author_image | img_url: 'master' }}" alt="{{ section.settings.review_author }}">
        </div>
        {% endif %}
        <div class="quiz__content">
          {% comment %} ⭐⭐⭐⭐⭐ {% endcomment %}
           <span class="rating-img"><img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Group_55.png?v=1758037849"></span>
          <p>{{ section.settings.review_quote }}</p>
          <span class="verify-person">
          <strong>{{ section.settings.review_author }}</strong>
          <span class="verified"><img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector_c848f606-5188-41c9-96d9-b348691fe7cb.png?v=1758037503"> {{ section.settings.review_verified }}</span></span>
        </div>
      </div>

    </div>
    </div>

    <!-- Right -->
    <div class="quiz-result-image">
      {% if quiz_product %}
        {% if quiz_product.featured_image %}
          <img src="{{ quiz_product.featured_image | img_url: '400x' }}" alt="{{ quiz_product.title }}">
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

<style>
.quiz-result-wrapper { text-align:center; padding:40px 20px; padding-top: 80px;background:#fbfbfb;}
.quiz-top-rating { font-size:14px; color:#777; margin-bottom:15px; }
.quiz-result-heading { font-size:32px; color:#4498CD; margin-bottom:30px;
font-family: Outfit;
    font-weight: 600;
    font-size: 72px;
    line-height: 110.00000000000001%;
    text-align: center;
    max-width: 762px;
    margin: auto;
    padding-bottom: 40px;
  }
.quiz-result-content { display:flex; justify-content:center; gap:40px; align-items:flex-start; flex-wrap:wrap; }
.quiz-result-text { max-width:420px; text-align:left; }
.quiz-stars { color:#f7b500; font-weight:600; margin-bottom:10px; }
.quiz-product-title {
    color: #4498CD;
    margin: 5px 0;
    font-family: Outfit;
    font-weight: 600;
    font-size: 40px;
    line-height: 90%;
    text-transform: capitalize;
}
.quiz-product-subtitle { font-size: 16px;
    color: #353535;
    margin-bottom: 5px;
    font-family: Outfit;
    font-weight: 400;
    line-height: 128%;
   }
.quiz-product-price { font-size:18px; margin:10px 0; font-weight:600; color: #353535; opacity: 0.65; }
.quiz-bullets { margin:15px 0; padding-left:0px; list-style:none; }
.quiz-bullets li {
    position: relative;
    padding-left: 20px;
    font-family: Outfit;
    font-weight: 500;
    font-size: 18px;
    line-height: 125%;
    align-items: center;
    display: flex;
    padding-bottom: 8px;
}
.quiz-bullets li::before { content:""; color:#2ca9e1; margin-right:8px;     background-image: url(https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector_c848f606-5188-41c9-96d9-b348691fe7cb.png?v=1758037503);
background-size: 15px;
    width: 15px;
    height: 15px;
    position: absolute;
    left: 0;
}
.quiz-result-content .quiz-result-text .inner-left {
    max-width: 507px;
}
.quiz-buttons { margin-top:15px; display:flex; gap:10px; }
.quiz-add-to-cart { background:#f7b500; color:#222; padding:12px 24px; border-radius:30px; font-weight:600; border:none; cursor:pointer; }
.quiz-find-retailer { background:#2ca9e1; color:#fff; padding:12px 24px; border-radius:30px; font-weight:600; text-decoration:none; display:inline-block; }
.quiz-result-image img { max-width:200px; margin:10px; border-radius:10px; }
.quiz-customer-review { margin-top:20px; padding:15px; background:#f9f9f9; border-radius:10px; font-size:14px; color:#333; display:flex; gap:15px; align-items:center; }
.quiz-customer-review .verified { color:#2ca9e1; font-weight:600; }
.quiz__author-img img { border-radius:50%; }


.quiz-result-content {
    flex-wrap: initial;
    max-width: 1200px;
    width: 100%;
    margin: auto;
}
.quiz-result-content .quiz-result-text {
    max-width: 50%;
    width: 100%;
}
.quiz-result-content .quiz-result-image {
    width: 50%;
    max-width: 50%;
}
.quiz-result-image img
 {
    max-width: 100%;
    margin: 10px;
    border-radius: 10px;
    width: 100%;
    height: auto !important;
    max-height: 490px;
    object-fit: cover;
}
section.alt-formulas .container {
    max-width: 700px;
    width: 100%;
    margin: auto;
}
section.alt-formulas .container .alt-grid article.alt-card {
    width: calc(50% - 20px);
    box-shadow: none;
}
.quiz-result-content .quiz-result-text .inner-left .quiz-buttons {
    flex-direction: column;
}
.quiz-result-content .quiz-result-text .inner-left .quiz-buttons button.quiz-add-to-cart {
    width: 100%;
    text-align: left;
}
.quiz-result-content .quiz__author-img img {
    border-radius: 4px;
}
.alt-formulas h2.alt-heading {
    color: #4498CD;
    font-family: Outfit;
    font-weight: 600;
    font-size: 56px;
    line-height: 90%;
    text-align: center;
    text-transform: capitalize;
}
p.alt-subheading {
    font-family: Outfit;
    font-weight: 500;
    font-size: 18px;
    line-height: 125%;
    text-align: center;
    vertical-align: middle;
    color: #353535;
}
.alt-img img {
    width: 100%;
    border-radius: 8px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
}
.alt-actions button.btn
 {
    width: 100%;
    color: #353535;
    font-family: Outfit;
    font-weight: 600;
    font-size: 20px;
    line-height: 125%;
}
.quiz-result-text .quiz-buttons button.quiz-add-to-cart {
    font-family: Outfit;
    font-weight: 600;
    font-size: 20px;
    line-height: 125%;
}
.quiz-result-content .quiz__author-img img {
    width: 96px !important;
    max-width: 96px;
}
.quiz-result-content .quiz-customer-review {
    background-color: #4498CD1A;
}
.quiz-result-content .quiz__content span.rating-img img {
    width: 63px;
    height: auto;
}
.quiz-result-content .quiz__content p {
    color: #353535;
    padding-top: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
}
.quiz-result-content .quiz-customer-review .verified img {
    width: 12px;
    height: 12px;
}
.quiz-result-content .quiz-customer-review .verified {
    display: flex;
    align-items: center;
    column-gap: 5px;
}
.quiz-result-content .quiz-customer-review .verified {
    color: #4498CD;
    display: flex;
    align-items: center;
    column-gap: 5px;
    font-family: Outfit;
    font-weight: 700;
    font-size: 12px;
    line-height: 120%;
    text-transform: uppercase;
}
.quiz-result-content span.verify-person {
    display: flex;
    column-gap: 6px;
}
.quiz-result-content a.quiz-find-retailer {
    font-family: Outfit;
    font-weight: 600;
    font-size: 20px;
    line-height: 125%;
}
.alt-formulas .alt-rating span.reviews {
    color: #353535;
}
.alt-formulas .alt-title a {
    font-family: Outfit;
    font-weight: 600;
    font-size: 24px;
    line-height: 90%;
    vertical-align: middle;
    text-transform: capitalize;
    color: #4498CD !important;
}
.alt-formulas p.alt-price {
    font-family: Outfit;
    font-weight: 500;
    font-size: 18px;
    line-height: 125%;
    color: #353535;
    opacity: 0.65;
    margin-top: 0px;
}
.alt-formulas .alt-desc {
    margin-top: 8px;
}
@media(max-width:768px){
  .quiz-result-heading {
      font-size: 23px;
      margin-bottom: 30px;
  }

  .quiz-result-content {
      display: grid;
  }

  .alt-formulas h2.alt-heading {
      font-size: 28px;
  }

  .bundle-promo .bundle-title {
    font-size: 26px;
}

.bundle-bullets li {
    display: flex;
    text-align: center;
    align-items: center;
    gap: 10px;
    max-width: 312px;
    width: 100%;
}

.bundle-bullets li:before {
    position: unset;
    left: 0;
    top: 0;
    font-weight: 700;
}

.bundle-btn {
    width: 100%;
}

  .bundle-right {
    width: 100%;
}

  section.alt-formulas .container .alt-grid article.alt-card {
    width: 100%; 
}

  .quiz-result-content .quiz-result-text {
      max-width: 100%;
      width: 100%;
  }
  .quiz-result-content .quiz-result-image {
    width: 100%;
    max-width: 100%;
}

.quiz__author-img {
    height: 100%;
    width: 100%;
    max-width:100px;
}

.quiz__content {
    font-size: 10px;
}
.bundle-promo {
    padding: 40px 20px 40px !important;
}
.bundle-promo .bundle-right .bundle-art .bundle-blob {
    display: none;
}
section.bundle-promo ul.bundle-bullets li {
    text-align: left;
}
.bundle-promo .bundle-left {
    text-align: left;
}
}

</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  var petName = localStorage.getItem("quiz_petname") || "";
  var span = document.getElementById("quizPetName");
  if (petName && petName.trim() !== "" && span) {
    span.textContent = petName;
  }
});
</script>

{% schema %}
{
  "name": "Quiz Result",
  "settings": [
    { "type": "product", "id": "default_product", "label": "Fallback Product" },
    { "type": "text", "id": "top_rating_text", "label": "Top rating text", "default": "4.8/5 loved by thousands of pet parents" },
    { "type": "text", "id": "heading_text", "label": "Heading Text", "default": "perfect Nutram recipe!" },
    { "type": "text", "id": "review_text", "label": "Review Stars Text", "default": "4.8/5 (100 reviews)" },
    { "type": "text", "id": "bullet_1", "label": "Bullet 1", "default": "Matches your pet’s needs, not the masses" },
    { "type": "text", "id": "bullet_2", "label": "Bullet 2", "default": "Built on our Digestive Wellness System™" },
    { "type": "text", "id": "bullet_3", "label": "Bullet 3", "default": "Backed by science, not guesswork" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add to Cart Text", "default": "Add to Cart" },
    { "type": "text", "id": "retailer_text", "label": "Retailer Button Text", "default": "Find the Retailer" },
    { "type": "url", "id": "retailer_url", "label": "Retailer URL" },
    { "type": "image_picker", "id": "author_image", "label": "Author image" },
    { "type": "text", "id": "review_quote", "label": "Customer Quote", "default": "After switching, Max’s coat is shinier and tummy trouble disappeared in two weeks!" },
    { "type": "text", "id": "review_author", "label": "Review Author", "default": "John D." },
    { "type": "text", "id": "review_verified", "label": "Verified Text", "default": "VERIFIED CUSTOMER" }
  ],
  "blocks": [
    {
      "type": "product_map",
      "name": "Product Mapping",
      "settings": [
        { "type": "text", "id": "product_id", "label": "Product ID (numeric)" },
        { "type": "text", "id": "product_handle", "label": "Product Handle" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quiz Result"
    }
  ]
}
{% endschema %}
