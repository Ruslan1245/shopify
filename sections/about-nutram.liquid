{% stylesheet %}
  /* ===== About Nutram Section (Scoped) ===== */
  .about-nutram-section {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* Background image with overlay */
  .about-nutram-section__bg {
    position: relative;
    width: 100%;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 60px 20px 180px;
  }

  .about-nutram-section__bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .about-nutram-section__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:  rgba(48, 134, 200, 0.75);
    z-index: 1;
  }

  /* Text styling */
  .about-nutram-section__heading {
    font-size: 56px;
    line-height: 90%;
    font-weight: 700;
    color: #fff;
    margin-bottom: 10px;
    position: relative;
    z-index: 2;
  }

  .about-nutram-section__subtext {
    font-size: 18px;
    line-height: 125%;
    color: #f0f0f0;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* Video wrapper */
  .about-nutram-section__video-wrapper {
    display: flex;
    justify-content: center;
    padding: 30px 20px;
  }

  .about-nutram-section__video {
    max-width: 800px;
    width: 100%;
    position: relative;
        margin-top: -130px;
    z-index: 9;
  }
  .about-nutram-section .video_below_content {
    max-width: 820px;
    margin: auto;
    padding: 0px 15px;
  }

  .about-nutram-section__video video {
    width: 100%;
    display: block;
    border-radius: 8px;
  }

  /* Play/Pause button overlay */
  .about-nutram-section__play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    width: 64px;
    height: 64px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 5;
    transition: background 0.3s ease;
  }

  .about-nutram-section__play-btn:hover {
    background: rgba(255, 255, 255, 1);
  }

  .about-nutram-section__play-btn svg {
    width: 28px;
    height: 28px;
    fill: #1b3a57;
  }

  /* ===== Food Safety Block ===== */
  .food-safety {
    padding: 40px 20px;
    max-width: 900px;
    padding-top:10px;
    margin: 0 auto;
    text-align: center;
  }

  .food-safety h3 {
    font-size: 56px;
    line-height: 90%;
    font-weight: 700;
    text-transform: capitalize;
    color: #4498CD;
    margin-bottom: 8px;
  }
  .food-safety ul li h3 {
    font-size: 32px;
}

  .food-safety p {
    font-size: 18px;
    line-height: 1.6;
    color: #333;
    margin-bottom: 15px;
  }

.food-safety ul {
    list-style: none;
    padding-left: 0;
    background-color: #fff;
    padding: 20px 20px;
    text-align: left;
    padding-bottom: 7px;
}

  .food-safety ul li {
    display: flex;
    align-items: flex-start;
    margin-bottom: 10px;
  }

  .food-safety ul li::before {
    content: "";
    background-image: url(https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector_6b2e525e-dbf2-4e22-bd82-495a47e38211.png?v=1755282084);
    color: #1b3a57;
    margin-right: 8px;
    font-size: 14px;
    flex-shrink: 0;
    position: absolute;
    left: -3px;
    top: 3px;
    background-repeat: no-repeat;
    background-size: 17px;
    width: 17px;
    height: 17px;
  }

  .about-nutram-section .mobileviewsec {
    display: flex;
    flex-direction: column;
    background-color: #F8F8F8;
}

.fsicon img.fsiconimg {
    width: 40px;
    height: auto;
}
.fsicon {
    text-align: center;
    display: flex;
    justify-content: center;
    padding-top: 45px;
}

   .food-safety ul li {
    flex-direction: column;
}
.food-safety ul li h3 {
    font-size: 18px;
    line-height: 125%;
    color: #4498CD;
    text-align: center;
    margin: 0 auto;
}
.food-safety ul li:first-child::before {
  display: none;
}
.food-safety ul li ul li:first-child::before{
  display: block;
}
.food-safety ul li ul li {
    font-size: 16px;
    line-height: 128%;
    position: relative;
    padding-left: 20px;
}

  /* Responsive */
  @media (max-width: 768px) {
    .about-nutram-section__heading {
      font-size: 48px;
    }
    .food-safety {
    display: block;
}
.about-nutram-section__subtext {
    font-size: 16px;
    line-height: 128%;
}
.food-safety h3 {
    font-size: 32px;
    line-height: 90%;
    margin: unset;
    text-transform: initial;
    text-align: left;
}

.food-safety ul ul {
    padding: 0px;
    padding-top: 12px;
}

.food-safety ul li h3 {
    padding-top: unset;
    text-align: left;
}

.food-safety ul {
    padding: 20px 20px;
    padding-bottom: 4px;
}

.about-nutram-section .video_below_content {
    padding: 0px 15px 30px;
  }

.food-safety {
    padding: 10px 15px 30px;
}
.food-safety p {
    font-size: 18px;
    line-height: 125%;
    text-align: center;
}
    .food-safety {
        background-color: #F8F8F8;
    }
 
.about-nutram-section__bg {
    padding: 60px 20px 60px;
}
.about-nutram-section__video {
    margin-top: 0;
}
  }
{% endstylesheet %}

<div class="about-nutram-section">
  <!-- Background Header -->
  <div
    class="about-nutram-section__bg"
    style="--overlay-color: {{ section.settings.overlay_color }};"
  >
    <style>
      .about-nutram-section__bg::before {
        background-image: url('{{ section.settings.bg_image | img_url: "1600x" }}');
      }
    </style>
    {% if section.settings.heading != blank %}
      <h2 class="about-nutram-section__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="about-nutram-section__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>

  <!-- Video -->
  {% if section.settings.video != blank %}
    <div class="about-nutram-section__video-wrapper">
      <div class="about-nutram-section__video">
        {{
          section.settings.video
          | video_tag: controls: false, autoplay: false, muted: false, loop: false, id: 'nutramVideo'
        }}
        <div class="about-nutram-section__play-btn" id="nutramPlayBtn">
          <svg id="nutramPlayIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.below_text != blank %}
      <div class="video_below_content">
        {{ section.settings.below_text }}
      </div>
    {% endif %}

  <div class="mobileviewsec">

    {% if section.settings.fsicon != blank %}
      <div class="fsicon">
        <img width="auto" height="auto" class="fsiconimg" src="{{ section.settings.fsicon | img_url:"master" }}">
      </div>
    {% endif %}

    <!-- Food Safety Block -->
    <div class="food-safety">
      {% if section.settings.fs_heading != blank %}
        <h3>{{ section.settings.fs_heading }}</h3>
      {% endif %}
      {% if section.settings.fs_text != blank %}
        <p>{{ section.settings.fs_text }}</p>
      {% endif %}

      {% if section.settings.fs_list != blank %}
        <ul>
          {% for item in section.settings.fs_list %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</div>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    const video = document.getElementById('nutramVideo');
    const playBtn = document.getElementById('nutramPlayBtn');
    const playIcon = document.getElementById('nutramPlayIcon');

    if (video && playBtn) {
      playBtn.addEventListener('click', function () {
        if (video.paused) {
          video.play();
          playIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>'; // pause icon
        } else {
          video.pause();
          playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>'; // play icon
        }
      });
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "About Nutram Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#00000066"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Nutram"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading Text",
      "default": "Trusted in over 30 countries worldwide..."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Upload Video"
    },
    {
      "type": "richtext",
      "id": "below_text",
      "label": "Below text"
    },
    {
      "type": "image_picker",
      "id": "fsicon",
      "label": "Food Safety icon"
    },
    {
      "type": "text",
      "id": "fs_heading",
      "label": "Food Safety Heading",
      "default": "Food Safety at Nutram"
    },
    {
      "type": "richtext",
      "id": "fs_text",
      "label": "Food Safety Intro",
    },
    {
      "type": "richtext",
      "id": "fs_list",
      "label": "Food Safety Points"
    }
  ],
  "presets": [
    {
      "name": "About Nutram Section"
    }
  ]
}
{% endschema %}
