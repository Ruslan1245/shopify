{% stylesheet %}
.custom-hero-section {
  display: flex;
  align-items: stretch;
  background-color: #fff;
}

.custom-hero-section .hero-left,
.custom-hero-section .hero-right {
  flex: 1;
}

.custom-hero-section .hero-left {
  padding: 2rem 3rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  
}

.canada-clean-kibble .hero-left {
background-color: #e5edf3;
}

.custom-hero-section .hero-subtitle {
  font-size: 14px;
  color: #555;
  margin-bottom: 0.5rem;
}

.custom-hero-section .hero-title {
	font-size: 72px;
	font-weight: 600;
	color: #4498CD;
  max-width:550px;
	margin-bottom: 0.4rem;
	margin-top: 0.4rem;
}

.custom-hero-section .hero-features {
  list-style: none;
  padding: 0;
  margin: 0 0 1.5rem 0;
}

.custom-hero-section .hero-features li {
  position: relative;
  padding-left: 28px;
  margin-bottom: 0.5rem;
  font-size: 16px;
  line-height: 1.4;
  color: #333;
}

.custom-hero-section .hero-features li::before {
  content: '';
  width: 16px;
  height: 16px;
  background: url('https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector.png?v=1755106804');
  position: absolute;
  left: 0;
  top: 3px;
  background-size: contain;
}

.custom-hero-section .hero-buttons {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.custom-hero-section .hero-buttons a {
	background-color: #ffc107;
	color: #353535;
	font-weight: 600;
	padding: .75rem 1.5rem;
	border-radius: 9999px;
	text-decoration: none;
	display: inline-flex;
	align-items: center;
	max-width: 248px;
	width: 100%;
	font-size: 20px;
	position: relative;
	display: flex;
	align-items: center;
	justify-content: space-between;
  padding-right: 1rem;
}

.custom-hero-section .hero-buttons a::after {
	content: "";
	background-image: url('https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector_5c1622c0-29e6-402a-a815-8da37656e4fc.png?v=1755184216');
	height: 15px;
	width: 30px;
	background-repeat: no-repeat;
	background-size: contain;
}

.our-story_home .hero-left .hero-title{
  font-size: 56px;
  color:#fff;
}

.our-story_home .hero-left .content p{
  color: #fff;
  max-width: 500px;
  width: 100%;
}

.our-story_home .hero-left {
  background-color: #4498CD;
}

.custom-hero-section .hero-buttons a:hover {
  background-color: #E6A800;
}

.custom-hero-section .hero-review {
	display: flex;
	align-items: flex-start;
	gap: .75rem;
	max-width: 504px;
	background-color: #4498CD1A;
	padding: 5px;
	border-radius: 5px;
}

.custom-hero-section .hero-review img {
	border-radius: 8px;
	max-width: 90px;
	max-height: 90px;
	object-fit: cover;
}

.verified_text img {
	height: 15px;
	width: 15px;
}

.verified_text {
	display: flex;
	align-items: center;
	gap: 5px;
	color: #4498CD;
}

.custom-hero-section .hero-review-text {
  font-size: 14px;
  line-height: 1.4;
  color: #444;
}

.custom-hero-section .hero-review-name {
	font-weight: 700;
	font-size: 14px;
	color: #353535;
	display: flex;
	gap: 10px;
}

.hero-subtitle {
  font-size: 18px;
  display: flex;
  align-items: center;
  gap: 8px; /* space between stars and text */
}

.custom-hero-section .hero-stars {
  color: gold; /* yellow stars */
  font-size: 18px; /* match text size */
  line-height: 1;
}

.canada-clean-kibble .hero-title{
  font-size: 56px;
  color: #353535;
  font-weight: 600;
}

.canada-clean-kibble .content p{
  font-size: 18px;
}

.canada-clean-kibble .hero-features li::before {
  background-image:url('https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector_68249d17-0684-487f-afc6-754aa8c89aea.png?v=1755184762');
}

.canada-clean-kibble .hero-buttons a {
	width: 100%;
	max-width: 500px;
	background-color: #4498CD;
	color: #fff;
}

.canada-clean-kibble .hero-buttons a::after {
  background-image:url('https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector_914f7b28-0d65-42ec-8a4f-a4f16f0ada9a.png?v=1755190591');
}

/* Desktop/Mobile Toggle */
.custom-hero-section.desktop-version {
  display: grid;
  grid-template-columns: 1fr 1fr;
 }
.custom-hero-section.mobile-version { display: none; flex-direction: column; }

@media (max-width: 1100px) {
  .custom-hero-section .hero-title {
    font-size: 34px;
  }
  .custom-hero-section .hero-features li {
    font-size: 14px;
  }
  .custom-hero-section .hero-buttons a {
    font-size: 14px;
  }

}

@media(max-width:900px){
  .custom-hero-section .hero-subtitle {
    font-size: 11px;
  }

  .canada-clean-kibble .content p {
    font-size: 10px;
  }

  .custom-hero-section .hero-title {
    font-size: 25px;
  }

  .custom-hero-section .hero-features li, .custom-hero-section .hero-buttons a {
    font-size: 10px;
  }

  .custom-hero-section .hero-review-text {
    font-size: 11px;
  }

  .custom-hero-section .hero-review-name {
    font-size: 12px;
  }

  .custom-hero-section .hero-review-name {
    font-size: 11px;
  }

  .custom-hero-section .hero-buttons a::after {
    height: 11px;
    width: 9px;
  }

}

@media (max-width: 768px) {
  .custom-hero-section.desktop-version { display: none; }
  .custom-hero-section.mobile-version { display: flex; padding: 1.5rem; }
  .custom-hero-section .hero-title { font-size: 28px; }
  .custom-hero-section .hero-features li {
    max-width: 350px;
    margin: 0 auto;
  }
}
{% endstylesheet %}
<section class="custom-hero-section desktop-version {{ section.settings.custom_class }}">
  <div class="hero-left">

    {% if section.settings.subtitle != blank %}
      <div class="hero-subtitle">
        <span class="hero-stars">★★★★★</span>
        {{ section.settings.subtitle }}
      </div>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 class="hero-title">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.settings.content != blank %}
      <div class="content">{{ section.settings.content }}</div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="hero-features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' and block.settings.feature_text != blank %}
            <li>{{ block.settings.feature_text }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    {% if section.settings.btn_cat_text != blank and section.settings.btn_cat_url != blank or section.settings.btn_dog_text != blank and section.settings.btn_dog_url != blank %}
      <div class="hero-buttons">
        {% if section.settings.btn_cat_text != blank and section.settings.btn_cat_url != blank %}
          <a href="{{ section.settings.btn_cat_url }}">{{ section.settings.btn_cat_text }}</a>
        {% endif %}
        {% if section.settings.btn_dog_text != blank and section.settings.btn_dog_url != blank %}
          <a href="{{ section.settings.btn_dog_url }}">{{ section.settings.btn_dog_text }}</a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.review_text != blank or section.settings.review_name != blank or section.settings.review_image != blank %}
      <div class="hero-review">
        {% if section.settings.review_image != blank %}
          <img src="{{ section.settings.review_image | img_url: 'master' }}" alt="">
        {% endif %}
        <div>
          <span class="hero-stars">★★★★★</span>
          {% if section.settings.review_text != blank %}
            <div class="hero-review-text">{{ section.settings.review_text }}</div>
          {% endif %}
          {% if section.settings.review_name != blank %}
            <div class="hero-review-name">
              <span class="review_name">{{ section.settings.review_name }}</span>
              <span class="verified_text">
               <img width="auto" height="auto" src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector_68249d17-0684-487f-afc6-754aa8c89aea.png?v=1755184762"> Verified Customer
              </span>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

  </div>

  {% if section.settings.hero_image != blank %}
    <div class="hero-right">
      <img src="{{ section.settings.hero_image | img_url: '800x' }}" alt="">
    </div>
  {% endif %}
</section>

<section class="custom-hero-section mobile-version {{section.settings.custom_class }}">

  {% if section.settings.mobile_hero_image != blank %}
    <div class="hero-right">
      <img src="{{ section.settings.mobile_hero_image | img_url: '600x' }}" alt="">
    </div>
  {% endif %}

  <div class="hero-left">

    {% if section.settings.subtitle != blank %}
      <div class="hero-subtitle">
        <span class="hero-stars">★★★★★</span>
        {{ section.settings.subtitle }}
      </div>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 class="hero-title">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.settings.content != blank %}
      <div class="content">{{ section.settings.content }}</div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="hero-features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' and block.settings.feature_text != blank %}
            <li>{{ block.settings.feature_text }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    {% if section.settings.btn_cat_text != blank and section.settings.btn_cat_url != blank or section.settings.btn_dog_text != blank and section.settings.btn_dog_url != blank %}
      <div class="hero-buttons">
        {% if section.settings.btn_cat_text != blank and section.settings.btn_cat_url != blank %}
          <a href="{{ section.settings.btn_cat_url }}">{{ section.settings.btn_cat_text }}</a>
        {% endif %}
        {% if section.settings.btn_dog_text != blank and section.settings.btn_dog_url != blank %}
          <a href="{{ section.settings.btn_dog_url }}">{{ section.settings.btn_dog_text }}</a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.review_text != blank or section.settings.review_name != blank or section.settings.review_image != blank %}
      <div class="hero-review">
        {% if section.settings.review_image != blank %}
          <img src="{{ section.settings.review_image | img_url: '60x60' }}" alt="">
        {% endif %}
        <div>
          {% if section.settings.review_text != blank %}
          <span class="hero-stars">★★★★★</span>
            <div class="hero-review-text">{{ section.settings.review_text }}</div>
          {% endif %}
          {% if section.settings.review_name != blank %}
            <div class="hero-review-name">{{ section.settings.review_name }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    {
      "type": "text",
      "id":"custom_class",
      "label":"Custom class"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Main Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_hero_image",
      "label": "Hero Main Image mobile"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "4.8/5 loved by thousands of pet parents"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Canada’s Cleanest Kibble"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "url",
      "id": "btn_cat_url",
      "label": "Shop For Cats Button Link"
    },
    {
      "type": "text",
      "id": "btn_cat_text",
      "label": "Shop For Cats Button Text",
      "default": "Shop For Cats"
    },
    {
      "type": "url",
      "id": "btn_dog_url",
      "label": "Shop For Dogs Button Link"
    },
    {
      "type": "text",
      "id": "btn_dog_text",
      "label": "Shop For Dogs Button Text",
      "default": "Shop For Dogs"
    },
    {
      "type": "image_picker",
      "id": "review_image",
      "label": "Review Customer Image"
    },
    {
      "type": "richtext",
      "id": "review_text",
      "label": "Review Text",
      "default": "<p>After switching, Max’s coat is shinier and tummy trouble disappeared in two weeks!</p>"
    },
    {
      "type": "text",
      "id": "review_name",
      "label": "Reviewer Name",
      "default": "John D."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "richtext",
          "id": "feature_text",
          "label": "Feature Text",
          "default": "<p>Visible digestive improvements, fast</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Hero Banner",
      "category": "Custom Sections",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
