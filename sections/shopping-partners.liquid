


<style>
.online-partners {
  text-align: center;
  padding: 40px 20px;
}
.online-partners .partners-heading {
  font-size: 56px;
  font-weight: bold;
  margin-bottom: 0px;
  color: #397dab
}
.online-partners .partners-subheading {
  font-size: 18px;
  color: #353535;
  margin-top: 0px;
  margin-bottom: 30px;
}
.online-partners {
  text-align: center;
  padding: 40px 20px;
}

.online-partners .partners-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 100px;
    max-width: 800px;
    margin: auto;
}

.online-partners .partner-item {
  text-align: center;
  max-width: 200px;
  flex: 1 1 150px;
      display: flex;
    flex-direction: column;
    justify-content: end;
}

.online-partners .partner-item img {
  max-height: 60px;
  margin-bottom: 10px;
  max-width: fit-content;
  margin:0 auto;
  height: auto;
}

.online-partners .partner-link a {
    font-size: 24px;
    color: #0066cc;
    text-decoration: underline;
}

.online-partners .partner-link a:hover {
    font-size: 24px;
    color: #0066cc !important;
    text-decoration: underline;
}

@media(max-width:810px){
  .online-partners .partners-heading {
    font-size: 32px;
    line-height: 90% !important;
  }
}

</style>



<section class="online-partners">
  <div class="container">
    <h2 class="partners-heading">{{ section.settings.heading }}</h2>
    <p class="partners-subheading">{{ section.settings.subheading }}</p>
    <div class="partners-wrapper">
    {% for block in section.blocks %}
      <div class="partner-item">
        {% if block.settings.logo != blank %}
          <a href="{{ block.settings.partner_link }}" target="_blank">
            <img src="{{ block.settings.logo | img_url: '200x' }}" alt="{{ block.settings.partner_name }}">
          </a>
        {% endif %}
        <p class="partner-link">
          <a href="{{ block.settings.partner_link }}" target="_blank">
            {{ block.settings.partner_name }}
          </a>
        </p>
      </div>
    {% endfor %}
  </div>
  </div>
</section>



{% schema %}
{
  "name": "Online Shopping Partners",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Prefer Shopping Online?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Order Nutram products from our trusted online partners with fast, secure delivery."
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Partner Logo"
        },
        {
          "type": "text",
          "id": "partner_name",
          "label": "Partner Name",
          "default": "Partner Name"
        },
        {
          "type": "url",
          "id": "partner_link",
          "label": "Partner Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Online Shopping Partners"
    }
  ]
}
{% endschema %}

