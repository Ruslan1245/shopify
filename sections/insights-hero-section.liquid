{% stylesheet %}
/* ==== Insights Hero Section ==== */
.insights-hero {
  position: relative;
  width: 100%;
  color: #fff;
  text-align: center;
  padding: 80px 20px;
  background-size: cover;
  background-position: center;
}

.insights-hero::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: {{ section.settings.overlay_color }};
  opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  z-index: 9;
}


.insights-hero__content {
  position: relative;
  z-index: 2;
  max-width: 900px;
  margin: 0 auto;
}

.insights-hero__heading {
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 25px;
}

.insights-hero__tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}

.insights-hero__tag {
  display: inline-block;
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 14px;
  background-color: #fff;
  color: #000;
  font-weight: 500;
  border: none;
  background-color: #F8C930;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.insights-hero__tag:hover {
  background-color: #f0f0f0;
      font-weight: 700;
}

@media (max-width: 768px) {
  .insights-hero {
    padding: 60px 15px;
  }
  .insights-hero__heading {
    font-size: 26px;
  }
}
{% endstylesheet %}

<div class="insights-hero" style="background-image: url('{{ section.settings.bg_image | img_url: '1600x' }}');">
  <div class="insights-hero__content">
    {% if section.settings.heading != blank %}
      <h2 class="insights-hero__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="insights-hero__tags">
        {% for block in section.blocks %}
          {% if block.settings.tag_text != blank %}
            <button class="insights-hero__tag">{{ block.settings.tag_text }}</button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Insights Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Discover Insights, Tips, And Trends"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#0073e6"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "settings": [
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag Text",
          "default": "Holistic Nutrition"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Insights Hero Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
