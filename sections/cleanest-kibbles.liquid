<section class="cleanest-kibbles">
  <div 
    class="cleanest-kibbles__bg cleanest-kibbles__bg--desktop"
    {% if collection.featured_image %}
      style="background-image: url('{{ collection.featured_image | img_url: '2000x' }}');"
    {% endif %}
  ></div>

  <div 
    class="cleanest-kibbles__bg cleanest-kibbles__bg--mobile"
    {% if collection.featured_image %}
      style="background-image: url('{{ collection.featured_image | img_url: '800x' }}');"
    {% endif %}
  ></div>

  {% if section.settings.overlay_enable %}
    <div 
      class="cleanest-kibbles__overlay" 
      style="background-color: {{ section.settings.overlay_color }};
             opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
    </div>
  {% endif %}

  <div class="cleanest-kibbles__content container">
    {% if section.settings.heading != blank %}
      <h2 class="cleanest-kibbles__heading">{{ section.settings.heading }}</h2>
    {% else %}
      <h2 class="cleanest-kibbles__heading">{{ collection.title }}</h2>
    {% endif %}

    <div class="cleanest-kibbles__features">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="cleanest-kibbles__feature">
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | img_url: '50x50' }}" alt="icon">
            {% endif %}
            <span>{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="cleanest-kibbles__filters">
      {% for block in section.blocks %}
        {% if block.type == 'filter' %}
          <a href="{{ block.settings.url }}" class="cleanest-kibbles__filter-btn {% if block.settings.active %}active{% endif %}">
            {{ block.settings.label }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="cleanest-kibbles__extras_badge">
      {% for block in section.blocks %}
    {% if block.type == 'badge' %}
        <div class="cleanest-kibbles__badge">
          {% if block.settings.badge_icon != blank %}
            <img src="{{ block.settings.badge_icon | img_url: '40x40' }}" alt="badge">
          {% endif %}
          <span>{{ block.settings.text }}</span>
        </div>
      {% endif %}
    {% endfor %}
    </div>

    <div class="cleanest-kibbles__extras">
      {% for block in section.blocks %}
        {% if block.type == 'button' %}
          <a href="{{ block.settings.url }}" class="cleanest-kibbles__cta">
            {{ block.settings.label }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cleanest Kibbles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Custom Heading"
    },
    {
      "type": "checkbox",
      "id": "overlay_enable",
      "label": "Enable Overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Icon + Text",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Text", "default": "Feature text here" }
      ]
    },
    {
      "type": "filter",
      "name": "Filter Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button Label", "default": "All Recipes" },
        { "type": "url", "id": "url", "label": "Button URL" },
        { "type": "checkbox", "id": "active", "label": "Set as Active?", "default": false }
      ]
    },
    {
      "type": "button",
      "name": "CTA Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button Label", "default": "Shop Now" },
        { "type": "url", "id": "url", "label": "Button URL" }
      ]
    },
    {
      "type": "badge",
      "name": "Verified Badge",
      "settings": [
        { "type": "image_picker", "id": "badge_icon", "label": "Badge Icon" },
        { "type": "text", "id": "text", "label": "Badge Text", "default": "Verified by experts" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cleanest Kibbles",
      "category": "Collection"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.cleanest-kibbles {
  position: relative;
  text-align: center;
  color: #fff;
  padding: 60px 20px;
  overflow: hidden;
}

.cleanest-kibbles__extras_badge {
	display: flex;
	justify-content: center;
	gap: 15px;
}

.cleanest-kibbles__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  z-index: 0;
}

.cleanest-kibbles__bg--mobile { display: none; }

@media(max-width: 768px){
  .cleanest-kibbles__bg--desktop { display: none; }
  .cleanest-kibbles__bg--mobile { display: block; }
}

.cleanest-kibbles__overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1;
}

.cleanest-kibbles__content {
  position: relative;
  z-index: 2;
}

.cleanest-kibbles__heading {
  font-size: 2rem;
  font-weight: bold;
  margin-bottom: 20px;
}

.cleanest-kibbles__features {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 25px;
}

.cleanest-kibbles__feature {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 1rem;
}

.cleanest-kibbles__feature img {
  width: 20px;
  height: 20px;
}

.cleanest-kibbles__filters {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
}

.cleanest-kibbles__filter-btn {
  padding: 8px 15px;
  border-radius: 20px;
  border: 1px solid #ccc;
  background: #fff;
  color: #333;
  font-weight: 600;
  transition: 0.3s;
}

.cleanest-kibbles__filter-btn.active {
  background: #fcd900;
  color: #000;
}

.cleanest-kibbles__cta {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 25px;
  background: #fcd900;
  color: #000;
  font-weight: bold;
  border-radius: 30px;
  transition: 0.3s;
}

.cleanest-kibbles__cta:hover {
  background: #e5c800;
}

.cleanest-kibbles__badge {
  margin-top: 15px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
}

.cleanest-kibbles__content.container > div:empty {
  display: none;
}


.cleanest-kibbles__badge img {
  width: 18px;
  height: 18px;
}
{% endstylesheet %}
