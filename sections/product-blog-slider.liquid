{% comment %}
  Section: Blog Slider (Nutram Blogs style)
{% endcomment %}

<section class="nutram-blogs">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="nutram-blogs__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="swiper nutram-blogs__slider">
      <div class="swiper-wrapper">
        {% assign blog_handle = section.settings.blog | default: 'news' %}
        {% for article in blogs[blog_handle].articles limit: section.settings.post_limit %}
          <div class="swiper-slide nutram-blogs__card">
            <div class="nutram-blogs__image">
              <a href="{{ article.url }}">
                <img src="{{ article.image | img_url: '600x400', crop: 'center' }}" alt="{{ article.title }}">
              </a>
              {% if article.tags.size > 0 %}
                <span class="nutram-blogs__tag">{{ article.tags[0] }}</span>
              {% endif %}
            </div>

            <div class="nutram-blogs__content">
              <small>{{ article.reading_time | default: 2 }} mins to read</small>
              <h3>{{ article.title }}</h3>
              <p>{{ article.excerpt | strip_html | truncate: 100 }}</p>
              <a href="{{ article.url }}" class="nutram-blogs__link"> {{ section.settings.read_more_text }}</a>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Navigation arrows -->
      <div class="nutram-blogs__nav nutram-blogs__nav--prev">
        <svg width="24" height="24" fill="currentColor">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </div>
      <div class="nutram-blogs__nav nutram-blogs__nav--next">
        <svg width="24" height="24" fill="currentColor">
          <path d="M9 6l6 6-6 6"/>
        </svg>
      </div>

      <!-- Pagination -->
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nutram Blog Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nutram Blogs"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "number",
      "id": "post_limit",
      "label": "Number of posts",
      "default": 6
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read More Text",
      "default": "Continue Reading"
    }
  ],
  "presets": [
    {
      "name": "Nutram Blog Slider",
      "category": "Blog"
    }
  ]
}
{% endschema %}

{% stylesheet %}
    .nutram-blogs {
      padding: 60px 20px;
      text-align: center;
      overflow-x: hidden;
    }
    .nutram-blogs__heading {
          font-size: 56px;
          font-weight: 600;
          margin-bottom: 40px;
          color: #4498CD;
      }
    .nutram-blogs__slider {
      position: relative;
    }
    .nutram-blogs__card {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      text-align: left;
    }
    .nutram-blogs__image {
      position: relative;
    }
    .nutram-blogs .nutram-blogs__image img {
      width: 100%;
      display: block;
      border-radius: 10px;
    }
    .nutram-blogs__tag {
      position: absolute;
      top: 12px;
      left: 12px;
      background: #3db2ff;
      color: #fff;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .nutram-blogs__slider {
      overflow-x: visible;
    }
    .nutram-blogs .container {
	max-width: 1240px;
	margin: 0 auto;
	padding: 0px 40px;
}
    .nutram-blogs__content {
      padding: 16px 0px;
    }
    .nutram-blogs__content small {
      color: #353535;
      font-size: 16px;
       line-height: 128%;
    }
    .nutram-blogs__content h3 {
          font-size: 18px;
    font-weight: 700;
    line-height: 125%;
    color: #353535;
        margin: 4px 0px;
    }
    .nutram-blogs__content p {
      font-size: 0.95rem;
      color: #444;
      margin-bottom: 10px;
    }
    .nutram-blogs .nutram-blogs__link {
  	font-weight: 600;
  	font-size: 16px;
  	color: #2F2F2CBF;
  	display: inline-flex;
  	align-items: center;
  	position: relative;
  	transition: 0.3s;
  	display: flex;
  	justify-content: flex-start;
  	width: fit-content;
  }

    .nutram-blogs .nutram-blogs__link:after {
  	content: "";
  	background-image: url('/cdn/shop/files/fi_271239.png?v=1755354557');
  	position: absolute;
  	top: 50%;
  	right: -21%;
  	height: 20px;
  	width: 20px;
  	background-repeat: no-repeat;
  	transform: translate(0%, -18%);
  }

  .nutram-blogs__nav {
  	position: absolute;
  	top: 50%;
  	transform: translateY(-50%);
  	background: #4498CD;
  	width: 40px;
  	height: 40px;
  	border-radius: 50%;
  	display: flex;
  	align-items: center;
  	justify-content: center;
  	cursor: pointer;
  	box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  	z-index: 99;
  	color: #fff;
  }
    .nutram-blogs__nav--prev { left: -20px; }
    .nutram-blogs__nav--next { right: -20px; }
{% endstylesheet %}

{% javascript %}
  var swiper = new Swiper('.nutram-blogs__slider', {
    slidesPerView: 1,
    spaceBetween: 20,
    loop: true,
    navigation: {
      nextEl: '.nutram-blogs__nav--next',
      prevEl: '.nutram-blogs__nav--prev',
    },
    breakpoints: {
      768: { slidesPerView: 2 },
      1024: { slidesPerView: 3 },
    },
  });
{% endjavascript %}
