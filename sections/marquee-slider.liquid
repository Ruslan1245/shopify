{% style %}

.square-slider {
	overflow: hidden;
	width: 100%;
	background: #F8F8F8;
	padding: 40px 0;
}

.slider-track {
  display: flex;
  width: max-content;
  animation: scroll-left 60s linear infinite;
}

.slide {
  flex: 0 0 auto;
  aspect-ratio: 1 / 1;
  width: 100%; 
  max-width:296px;
  margin: 0 5px;
  border-radius: 6px;
  overflow: hidden;
}

.slide img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Ensures image fills square without stretching */
  display: block;
  border-radius: 6px;
}

@keyframes scroll-left {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@media (max-width: 1100px) {
  .square-slider .slide {
    max-width: 150px;
  }
}

{% endstyle %}



<section class="square-slider">
  <div class="slider-track">
    {% for block in section.blocks %}
      {% if block.settings.slide_image != blank %}
        <div class="slide">
          <img src="{{ block.settings.slide_image | img_url: '400x400' }}" alt="Slide {{ forloop.index }}">
        </div>
      {% endif %}
    {% endfor %}
    {% for block in section.blocks %}
      {% if block.settings.slide_image != blank %}
        <div class="slide">
          <img src="{{ block.settings.slide_image | img_url: '400x400' }}" alt="Slide {{ forloop.index }}">
        </div>
      {% endif %}
    {% endfor %}
    {% for block in section.blocks %}
      {% if block.settings.slide_image != blank %}
        <div class="slide">
          <img src="{{ block.settings.slide_image | img_url: '400x400' }}" alt="Slide {{ forloop.index }}">
        </div>
      {% endif %}
    {% endfor %}
    {% for block in section.blocks %}
      {% if block.settings.slide_image != blank %}
        <div class="slide">
          <img src="{{ block.settings.slide_image | img_url: '400x400' }}" alt="Slide {{ forloop.index }}">
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>





{% schema %}
{
  "name": "Continuous Square Slider",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Slider Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Upload Image"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Continuous Square Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}