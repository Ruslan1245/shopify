{% style %}
.custom-contact-form {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  padding: {{ section.settings.section_padding }}px 20px;
  background: {{ section.settings.background_color }};
}

/* .custom-contact-form__title {
  font-size: {{ section.settings.heading_size }}px;
  font-weight: 700;
  text-align: center;
  margin-bottom: 30px;
  color: {{ section.settings.heading_color }};
  {% if section.settings.heading_underline %} text-decoration: underline; {% endif %}
} */

h2.custom-contact-form__title {
    font-family: Outfit;
    font-weight: 600;
    font-style: SemiBold;
    font-size: 42px;
    line-height: 34px;
    text-align: center;
    text-transform: capitalize;
}

.custom-contact-form form {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.custom-contact-form input,
.custom-contact-form textarea {
  width: 100%;
  padding: 14px 18px;
  border-radius: {{ section.settings.input_radius }}px;
  border: 1px solid {{ section.settings.input_border }};
  font-size: 16px;
  outline: none;
  transition: border-color 0.3s;
  background: {{ section.settings.input_bg }};
  color: {{ section.settings.input_text }};
}

.custom-contact-form input:focus,
.custom-contact-form textarea:focus {
  border-color: {{ section.settings.input_focus }};
}

.custom-contact-form__half {
  flex: 1 1 48%;
}

.custom-contact-form__full {
  flex: 1 1 100%;
}

.custom-contact-form__checkbox {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 10px 0 20px;
  font-size: 14px;
  flex-wrap: wrap;
  color: {{ section.settings.checkbox_text }};
}

.custom-contact-form__checkbox span {
  display: flex;
  align-items: center;
  gap: 4px;
}

.custom-contact-form button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: {{ section.settings.button_bg }};
  color: {{ section.settings.button_text_color }};
  border: none;
  border-radius: {{ section.settings.button_radius }}px;
  padding: 14px 30px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.3s;
}

.custom-contact-form button:hover {
  background: {{ section.settings.button_hover }};
}

/* Responsive */
@media (max-width: 767px) {
  .custom-contact-form__half {
    flex: 1 1 100%;
  }
  .custom-contact-form__title {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }
}
{% endstyle %}

<section class="custom-contact-form">
  {% if section.settings.heading != blank %}
    <h2 class="custom-contact-form__title">{{ section.settings.heading }}</h2>
  {% endif %}

  {% form 'contact', id: 'custom_contact_form' %}
    <div class="custom-contact-form__half">
      <input type="text" name="contact[first_name]" placeholder="First Name" required>
    </div>
    <div class="custom-contact-form__half">
      <input type="text" name="contact[last_name]" placeholder="Last Name" required>
    </div>
    <div class="custom-contact-form__full">
      <input type="email" name="contact[email]" placeholder="Email Address" required>
    </div>
    <div class="custom-contact-form__full">
      <input type="tel" name="contact[phone]" placeholder="Phone Number">
    </div>
    <div class="custom-contact-form__full">
      <textarea name="contact[body]" rows="4" placeholder="How can we help?"></textarea>
    </div>

    <div class="custom-contact-form__checkbox">
      <input type="checkbox" id="terms_checkbox" required>
      <label for="terms_checkbox">{{ section.settings.terms_text }}</label>
      <span>🔒 {{ section.settings.secure_text }}</span>
    </div>

    <div class="custom-contact-form__full">
      <button type="submit">
        {{ section.settings.button_text }}
        <span>→</span>
      </button>
    </div>
  {% endform %}
</section>

{% schema %}
{
  "name": "Custom Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Form Heading",
      "default": "Fill In The Form Below"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0066cc"
    },
    {
      "type": "checkbox",
      "id": "heading_underline",
      "label": "Underline Heading",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (Desktop)",
      "min": 16,
      "max": 50,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Font Size (Mobile)",
      "min": 14,
      "max": 40,
      "step": 1,
      "default": 22
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Input Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_text",
      "label": "Input Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "Input Border Color",
      "default": "#dddddd"
    },
    {
      "type": "color",
      "id": "input_focus",
      "label": "Input Focus Border Color",
      "default": "#0066cc"
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "Input Border Radius (px)",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "checkbox_text",
      "label": "Checkbox Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "terms_text",
      "label": "Terms Checkbox Text",
      "default": "I accept the terms & conditions"
    },
    {
      "type": "text",
      "id": "secure_text",
      "label": "Secure Details Text",
      "default": "Your details are secure with us"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Started Today"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background Color",
      "default": "#ffc107"
    },
    {
      "type": "color",
      "id": "button_hover",
      "label": "Button Hover Background Color",
      "default": "#e6a900"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button Border Radius (px)",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Form Max Width (px)",
      "min": 400,
      "max": 1200,
      "step": 20,
      "default": 800
    }
  ],
  "presets": [
    {
      "name": "Custom Contact Form",
      "category": "Custom"
    }
  ]
}
{% endschema %}
