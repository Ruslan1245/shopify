{% schema %}
{
  "name": "Store Locator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy In-Store" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Enter your city or postal code to find Nutram retailers near you."
    },
    {
      "type": "text",
      "id": "google_api_key",
      "label": "Google Maps API Key",
      "default": "AIzaSyAEQ2dAw4HDbLS_IJf5JTIS78x9vAY6ai8"
    },
    { "type": "number", "id": "max_results", "label": "Max results to show", "default": 6 },
    { "type": "number", "id": "radius_km", "label": "Search radius (km)", "default": 50 }
  ],
  "presets": [
    {
      "name": "Store Locator",
      "category": "Stores"
    }
  ]
}
{% endschema %}

{% comment %}
  This section loads stores from: {{ 'stores.json' | asset_url }}
  Make sure stores.json contains lat & lng numeric fields for each store.
{% endcomment %}

<style>
  /* --- visual styles inspired by your Figma --- */
  .store-locator-{{ section.id }} { --blue: #4498CD; --blue-dark:#4498CD; --muted:#6c778a; --border:#e6e9f1; padding: 42px 16px; background:#F8F8F8; }
  .store-locator-{{ section.id }} .wrap { max-width:1264px; margin:0 auto; padding-top: 40px; }
  .store-locator-{{ section.id }} .title { text-align:center; font-size:56px; font-weight:800; color:var(--blue); margin-bottom:6px; }
  .store-locator-{{ section.id }} .sub { text-align: center;
    color: #353535;
    margin-bottom: 18px;
    font-size: 18px;
    font-family: var(--font-h2--family); }

  /* search row */
  .store-locator-{{ section.id }} .controls { display:flex; gap:12px; align-items:center; justify-content:center; flex-wrap:wrap; margin-bottom:18px; padding-top: 20px; }
  .sl-search { position:relative; width:min(400px,92%); background:#E8EDF2; border:1px solid var(--border); border-radius:28px; padding:10px 18px 10px 46px; box-shadow: 0 1px 0 rgba(0,0,0,.03); }
  .sl-search input { width:100%; border:0; outline:0; font-size:15px; color:#334155; background:transparent; }
  .sl-ico { position:absolute; left:14px; top:50%; transform:translateY(-50%); width:18px; height:18px; opacity:.6; }
  .sl-loc {
    display: flex;
    gap: 8px;
    font-family: var(--font-h2--family);
    align-items: center;
    background: #F7FAFC;
    border: 1px solid #F7FAFC;
    border-radius: 2px;
    padding: 5px 7px;
    color: #353535;
    max-width: 300px;
    width: 100%;
}

.sl-loc .icon{
    background-color: #E8EDF2;
    border-radius: 8px;
    padding: 8px;
}
.sl-cta { 
    display: flex;
    align-items: center;
    gap: 10px;
    background: #5E5C5C;
    color: #fff;
    font-family: var(--font-h2--family);
    border-radius: 28px;
    padding: 10px 18px;
    border: 0;
    cursor: pointer;
    font-weight: 600;
    font-weight: 600;
    padding: .75rem 1.5rem;
    border-radius: 9999px;
    background-color: #4498CD;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    max-width: 370px;
    width: 100%;
    font-size: 18px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 1rem;
}


.sl-cta::after {
    content: "";
     background-image: url('/cdn/shop/files/Vector_914f7b28-0d65-42ec-8a4f-a4f16f0ada9a.png?v=1755190591');
    height: 15px;
    width: 30px;
    background-repeat: no-repeat;
    background-size: contain;
}

  /* map */
  .store-locator-{{ section.id }} .map-wrap { border:1px solid var(--border); border-radius:12px; overflow:hidden; background:#f7fbff; margin-bottom:22px; }
  #map-{{ section.id }} { width:100%; height:420px; }

  /* results */
.sl-results-head {
    display: none;
    margin: 18px 0;
    color: #4498CD;
    font-weight: 800;
    font-size: 40px;
    padding-top: 20px;
    text-transform: capitalize;
} .sl-grid { display:grid; grid-template-columns:1fr; gap:14px; }
  @media(min-width:920px){ .sl-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}
 }

.sl-card {
    background: #fff;
    border-radius: 5px;
    padding: 40px 20px;
    box-shadow: 0 8px 24px rgba(30,41,59,.04);
    max-width: 355px;
    width: 100%;
}
.sl-card h3 {
    margin: 0 0 0px;
    font-size: 24px;
    color: var(--blue-dark);
    font-weight: 800;
    text-transform: capitalize;
}
.sl-distance {
    color: #353535;
    font-size: 18px;
    margin-bottom: 8px;
    font-weight: 500;
    margin-top: 6px;
}
  .sl-meta{ color:#334155; font-size:14px; display:grid; gap:6px; }
  .actions{ display:flex; gap:10px; margin-top:12px; flex-wrap:wrap; }
  .btn{ padding:8px 12px; border-radius:999px; font-size:14px; text-decoration:none; text-align:center; display:inline-block; border:1px solid var(--blue); color:var(--blue); background:#fff; }
  .btn.primary{ background:var(--blue); color:#fff; border-color:var(--blue); }
  .store-locator-{{ section.id }} .btn {
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 14px;
    text-decoration: none;
    text-align: center;
    display: flex;
    /* border: 1px solid var(--blue); */
    color: white;
    font-weight: 600;
    background: #4498CD;
    max-width: 148px;
    width: 100%;
    justify-content:center;
    align-items: center;
    gap: 5px;
}
.location__current{
  font-size:16px;
  margin:0 auto;
}

  .sl-loc input:checked ~ span {
    color: var(--blue);
  }

  .sl-loc input:checked ~ span svg {
    stroke: var(--blue);
  }
.sl-meta-location {
    display: flex;
    gap: 4px;
    align-items: center;
    font-size: 16px;
    color: #2F2F2CBF;
    padding: 10px 0px;
}

@media(max-width:1200px){

  .sl-card {
      max-width: 100%;
  }

  .sl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
}

}

@media(max-width:810px){
  .store-locator-{{ section.id }}{
        padding: 0px 15px;
                padding-bottom: 40px;
  }

  .sl-grid {
    display: grid;
    grid-template-columns: 1fr;
}

  .store-locator-{{ section.id }} .wrap {
    padding-top: 0px;
  }

  .store-locator-{{ section.id }} .title {
    font-size: 36px;
  }

  .sl-loc {
      background: #E8EDF2;
      border: 1px solid #E8EDF2;
      border-radius: 30px;
  }

  .sl-loc .icon {
      background-color: #E8EDF2;
      border-radius: 8px;
      padding: 0px;
  }

}
</style>

<section class="store-locator-{{ section.id }}">
  <div class="wrap">
    <h2 class="title">{{ section.settings.heading }}</h2>
    <div class="sub">{{ section.settings.subheading }}</div>

    <div class="controls" role="region" aria-label="store locator controls">
      <div class="sl-search" aria-hidden="false">
        <svg class="sl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="11" cy="11" r="7" stroke-width="2"></circle><line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2"></line>
        </svg>
        <input id="sl-search-{{ section.id }}" type="text" placeholder="Search by City or Postal Code">
      </div>

      <label class="sl-loc" title="Use my current location">
        <input id="sl-use-geo-{{ section.id }}" type="checkbox" style="accent-color:var(--blue);display:none">
        <span class="icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s-6-5.1-6-10a6 6 0 1 1 12 0c0 4.9-6 10-6 10z"/>
            <circle cx="12" cy="11" r="2"/>
          </svg>
        </span>
        <span class="location__current">Use my current location</span>
      </label>

      <button id="sl-go-{{ section.id }}" class="sl-cta">Show My Closest Stores</button>
    </div>

    <div class="map-wrap">
      <div id="map-{{ section.id }}"></div>
    </div>

    <h3 id="sl-results-title-{{ section.id }}" class="sl-results-head">Showing Results</h3>
    <div id="sl-results-{{ section.id }}" class="sl-grid"></div>

    <!-- invisible container for quick debug/errors -->
    <div id="sl-debug-{{ section.id }}" style="display:none;color:#d00;margin-top:10px"></div>
  </div>
</section>

<script>
(function(){
  // sanitize section-based identifiers for callback name (must begin with a letter)
  const rawId = "{{ section.id }}";
  const safeId = "{{ section.id | replace: '-', '' }}"; // remove dashes
  const mapCallbackName = "initMap_s" + safeId; // always starts with letter
  const storesUrl = "{{ 'stores.json' | asset_url }}";
  const apiKey = "{{ section.settings.google_api_key }}";
  const maxResults = parseInt({{ section.settings.max_results }}, 10) || 6;
  const radiusKm = parseFloat({{ section.settings.radius_km }}) || 50;

  const searchInput = document.getElementById("sl-search-{{ section.id }}");
  const useGeoEl = document.getElementById("sl-use-geo-{{ section.id }}");
  const goBtn = document.getElementById("sl-go-{{ section.id }}");
  const resultsTitle = document.getElementById("sl-results-title-{{ section.id }}");
  const resultsGrid = document.getElementById("sl-results-{{ section.id }}");
  const debugEl = document.getElementById("sl-debug-{{ section.id }}");

  let map, geocoder, userMarker = null, storeMarkers = [];
  let STORES = [];
  let mapsReady = false, storesReady = false;

  // Load stores.json from assets
  fetch(storesUrl).then(r => {
    if (!r.ok) throw new Error("Could not load stores.json (check uploads/assets).");
    return r.json();
  }).then(data => {
    // Expect array of objects with lat/lng numeric
    STORES = Array.isArray(data) ? data.map(s => ({
      name: s.name || s.Name || s.name || "",
      address: s.address || s.Address || s.address || "",
      phone: s.phone || s.Phone || "",
      website: s.website || s.Website || s.website || "",
      lat: Number(s.lat ?? s.Latitude ?? s.latitude),
      lng: Number(s.lng ?? s.Longitude ?? s.longitude)
    })) : [];
    storesReady = true;
  }).catch(err => {
    debugEl.style.display = "block"; debugEl.textContent = "Stores JSON load error: " + err.message;
  });

  // Utility: haversine
  function haversineKm(lat1, lon1, lat2, lon2){
    const toRad = d => d * Math.PI/180;
    const R = 6371;
    const dLat = toRad(lat2-lat1), dLon = toRad(lon2-lon1);
    const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon/2)**2;
    return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)));
  }

  // map callback: will be called by Google API using callback query param (see script tag below)
  window[mapCallbackName] = function(){
    mapsReady = true;
    geocoder = new google.maps.Geocoder();
    map = new google.maps.Map(document.getElementById("map-{{ section.id }}"), {
      center: { lat: 43.6532, lng: -79.3832 }, // default center (Toronto)
      zoom: 6,
      mapTypeControl: false,
      streetViewControl: false
    });
  };

  // helpers to manage markers & cards
  function clearStoreMarkers(){
    storeMarkers.forEach(m => m.setMap(null));
    storeMarkers = [];
  }
  function renderMarkers(list){
    clearStoreMarkers();
    list.forEach(s => {
      if (Number.isFinite(s.lat) && Number.isFinite(s.lng)) {
        const m = new google.maps.Marker({
          map, position: { lat: s.lat, lng: s.lng }, title: s.name
        });
        const iw = new google.maps.InfoWindow({
          content: `<strong>${escapeHtml(s.name)}</strong><div style="font-size:13px">${escapeHtml(s.address)}</div>`
        });
        m.addListener("click", () => iw.open(map, m));
        storeMarkers.push(m);
      }
    });
  }
  function renderCards(list){
    resultsGrid.innerHTML = "";
    if (!list.length){
      resultsTitle.style.display = "none";
      resultsGrid.innerHTML = `<div style="grid-column:1/-1;color:var(--muted)">No stores found in this area.</div>`;
      return;
    }
    resultsTitle.style.display = "block";
    resultsTitle.textContent = `Showing ${list.length} Location${list.length===1 ? "" : "s"}`;
    list.forEach(s => {
      const div = document.createElement("div");
      div.className = "sl-card";
      const distText = (typeof s.distanceKm === "number") ? `${s.distanceKm.toFixed(1)} km` : "—";
      div.innerHTML = `
        <h3>${escapeHtml(s.name)}</h3>
        <div class="sl-distance">Distance from you: ${distText}</div>
        <div class="sl-meta">
          <div class="sl-meta-location">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgb(68 152 205)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-6-5.1-6-10a6 6 0 1 1 12 0c0 4.9-6 10-6 10z"/>
              <circle cx="12" cy="11" r="2"/>
            </svg>
            ${escapeHtml(s.address)}
          </div>
          ${s.phone ? `<div>☎️ ${escapeHtml(s.phone)}</div>` : ""}
        </div>
        <div class="actions">
          <a class="btn primary" target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(s.address)}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="#ffffff">
            <path d="M12 2C8.14 2 5 5.14 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.86-3.14-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/>
          </svg>
          <span>Get Directions</span>
          </a>
          ${s.website ? `<a class="btn" target="_blank" rel="noopener" href="${escapeAttr(s.website)}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
 <path d="M2 12H22M2 12C2 17.5228 6.47715 22 12 22M2 12C2 6.47715 6.47715 2 12 2M22 12C22 17.5228 17.5228 22 12 22M22 12C22 6.47715 17.5228 2 12 2M12 2C14.5013 4.73835 15.9228 8.29203 16 12C15.9228 15.708 14.5013 19.2616 12 22M12 2C9.49872 4.73835 8.07725 8.29203 8 12C8.07725 15.708 9.49872 19.2616 12 22" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
 </svg><span>Visit Website</span></a>` : ""}
        </div>
      `;
      resultsGrid.appendChild(div);
    });
  }

  // compute and show closest stores from given coords
  function computeClosestFrom(lat, lng){
    if (!STORES.length) { debugEl.style.display="block"; debugEl.textContent = "No stores loaded."; return; }
    // enrich distances, filter by numeric lat/lng present, optionally within radius
    const enriched = STORES
      .filter(s => Number.isFinite(s.lat) && Number.isFinite(s.lng))
      .map(s => ({ ...s, distanceKm: haversineKm(lat, lng, s.lat, s.lng) }))
      .filter(s => s.distanceKm <= radiusKm)
      .sort((a,b)=> a.distanceKm - b.distanceKm)
      .slice(0, maxResults);

    renderCards(enriched);
    if (mapsReady && typeof google !== "undefined") {
      renderMarkers(enriched);
      map.setCenter({ lat, lng });
      map.setZoom(enriched.length ? 11 : 10);
      // place/replace user marker
      if (userMarker) userMarker.setMap(null);
      userMarker = new google.maps.Marker({
        map, position: { lat, lng }, title: "You are here",
        icon: { path: google.maps.SymbolPath.CIRCLE, scale: 6, fillColor:"#1e88e5", fillOpacity:1, strokeWeight:2, strokeColor:"#fff" }
      });
    } else {
      // maps not ready yet: try small delay
      debugEl.style.display = "block"; debugEl.textContent = "Map not ready yet — try again in a moment.";
    }
  }

  // main search runner
  function runSearch(){
    debugEl.style.display = "none"; debugEl.textContent = "";
    if (!storesReady) { debugEl.style.display="block"; debugEl.textContent="Stores still loading. Try again in a second."; return; }
    if (!mapsReady) { debugEl.style.display="block"; debugEl.textContent="Map still loading. Try again in a second."; return; }

    const wantGeo = useGeoEl.checked;
    const q = searchInput.value.trim();

    if (wantGeo && navigator.geolocation){
      navigator.geolocation.getCurrentPosition(
        pos => computeClosestFrom(pos.coords.latitude, pos.coords.longitude),
        err => alert("Unable to get your location. Allow location or search by postal code.")
      );
      return;
    }

    if (q.length){
      geocoder.geocode({ address: q }, (res,status) => {
        if (status === "OK" && res && res[0]){
          const loc = res[0].geometry.location;
          computeClosestFrom(loc.lat(), loc.lng());
        } else {
          alert("Address/postal code not found. Try a full postal code (e.g. M5B 2H1) or nearby city name.");
        }
      });
      return;
    }

    alert("Please enter a postal code/city or enable 'Use my current location'.");
  }

  // attach handler
  goBtn.addEventListener("click", runSearch);

  // small helpers to escape HTML
  function escapeHtml(s){ return String(s || "").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function escapeAttr(s){ return String(s || "").replace(/"/g,'&quot;'); }

  // Clean up window reference on unload (optional)
  window.addEventListener("unload", () => { try { delete window[mapCallbackName]; } catch(e){} });

  // Insert Google maps script tag dynamically with callback param to this unique name
  // Only append once
  (function insertMapsScript(){
    // If script exists or google already present, skip & set mapsReady true if possible
    if (window.google && window.google.maps){ mapsReady = true; return; }
    const s = document.createElement("script");
    s.src = "https://maps.googleapis.com/maps/api/js?key={{ section.settings.google_api_key }}&callback=" + mapCallbackName;
    s.async = true; s.defer = true;
    s.onerror = function(){ debugEl.style.display="block"; debugEl.textContent = "Failed to load Google Maps JS. Check API key & billing."; };
    document.head.appendChild(s);
  })();

})();
</script>
