{% comment %}
  Section: Alternate Dry Formulas
  - If URL has ?product_id=xxx → show mapped products via blocks.
  - Else → show fallback products chosen in settings.
{% endcomment %}

{% assign query_id = request.params.product_id %}
{% assign left_handle = blank %}
{% assign right_handle = blank %}

{%- if query_id != blank -%}
  {%- for block in section.blocks -%}
    {%- if block.type == "product_map" and block.settings.product_id == query_id -%}
      {% assign left_handle  = block.settings.left_product %}
      {% assign right_handle = block.settings.right_product %}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if left_handle == blank -%}
  {% assign left_handle = section.settings.fallback_left %}
{%- endif -%}
{%- if right_handle == blank -%}
  {% assign right_handle = section.settings.fallback_right %}
{%- endif -%}

{%- assign left_product  = all_products[left_handle] %}
{%- assign right_product = all_products[right_handle] %}

<section class="alt-formulas">
  <div class="container">
    <h2 class="alt-heading">{{ section.settings.heading }}</h2>
    <p class="alt-subheading">{{ section.settings.subheading }}</p>

    <div class="alt-grid">
      {% if left_product %}
      <article class="alt-card">
        <div class="alt-img">
          <a href="{{ left_product.url }}">
            <img src="{{ left_product.featured_image | img_url: '600x' }}" alt="{{ left_product.title }}">
          </a>
        </div>
        <div class="alt-info">
          <div class="alt-rating">
            <span class="stars">★★★★★</span>
            <span class="reviews">{{ section.settings.reviews_text }}</span>
          </div>
          <h3 class="alt-title"><a href="{{ left_product.url }}">{{ left_product.title }}</a></h3>
          <p class="alt-desc">Chicken and Turkey Recipe}</p>
          <p class="alt-price">From {{ left_product.price_min | money }}</p>
          <div class="alt-actions">
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ left_product.first_available_variant.id }}">
              <button type="submit" class="btn btn-primary">{{ section.settings.add_to_cart_text }}</button>
            </form>
          </div>
        </div>
      </article>
      {% endif %}

      {% if right_product %}
      <article class="alt-card">
        <div class="alt-img">
          <a href="{{ right_product.url }}">
            <img src="{{ right_product.featured_image | img_url: '600x' }}" alt="{{ right_product.title }}">
          </a>
        </div>
        <div class="alt-info">
          <div class="alt-rating">
            <span class="stars">★★★★★</span>
            <span class="reviews">{{ section.settings.reviews_text }}</span>
          </div>
          <h3 class="alt-title"><a href="{{ right_product.url }}">{{ right_product.title }}</a></h3>
          <p class="alt-desc">Chicken and Turkey Recipe/p>
          <p class="alt-price">From {{ right_product.price_min | money }}</p>
          <div class="alt-actions">
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ right_product.first_available_variant.id }}">
              <button type="submit" class="btn btn-primary">{{ section.settings.add_to_cart_text }}</button>
            </form>
          </div>
        </div>
      </article>
      {% endif %}
    </div>
  </div>
</section>

<style>
.alt-formulas { padding:50px 20px; text-align:center; background:#fff; }
.alt-heading { font-size:32px; color:#2ca9e1; font-weight:700; margin-bottom:8px; }
.alt-subheading { color:#555; margin-bottom:28px; }
.alt-grid { display:flex; gap:40px; justify-content:center; flex-wrap:wrap; }
.alt-card { background:#fff; border-radius:12px; text-align:left; width:400px; box-shadow:0 2px 6px rgba(0,0,0,0.08); padding:20px; }
.alt-img img { width:100%; border-radius:8px; }
.alt-info { margin-top:14px; }
.alt-rating { display:flex; align-items:center; gap:8px; color:#f7b500; font-weight:600; }
.stars { font-size:14px; }
.reviews { color:#222; font-size:14px; }
.alt-title { font-size:20px; font-weight:700; color:#2ca9e1; margin:6px 0; }
.alt-title a { color:inherit; text-decoration:none; }
.alt-desc { color:#353535; margin-bottom:8px; font-size:16px; }
.alt-price { font-weight:700; margin-bottom:14px; color:#111; }
.alt-actions .btn { padding:12px 24px; border-radius:30px; font-weight:700; border:0; cursor:pointer; }
.btn-primary { background:#f7b500; color:#111; }
@media(max-width:900px){ .alt-grid{flex-direction:column;align-items:center;} .alt-card{width:90%;} }
</style>

{% schema %}
{
  "name": "Alternate Dry Formulas",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Alternate Dry Formulas" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Order Nutram products from our trusted partners with fast, secure delivery." },
    { "type": "product", "id": "fallback_left", "label": "Fallback Left Product" },
    { "type": "product", "id": "fallback_right", "label": "Fallback Right Product" },
    { "type": "text", "id": "reviews_text", "label": "Reviews text", "default": "4.9/5.0 (100 reviews)" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add to cart button text", "default": "Shop Now" }
  ],
  "blocks": [
    {
      "type": "product_map",
      "name": "Product Mapping",
      "settings": [
        { "type": "text", "id": "product_id", "label": "Product ID (from URL)" },
        { "type": "product", "id": "left_product", "label": "Left Product" },
        { "type": "product", "id": "right_product", "label": "Right Product" }
      ]
    }
  ],
  "presets": [
    { "name": "Alternate Dry Formulas" }
  ]
}
{% endschema %}
