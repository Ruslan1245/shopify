{% style %}
  .contact-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .contact-banner__background {
    position: relative;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-banner__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .contact-banner__content {
    position: relative;
    z-index: 2;
    color: #fff;
    text-align: center;
    padding: 20px;
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-banner__content--left {
    text-align: left;
    margin-left: 5%;
  }

  .contact-banner__content--right {
    text-align: right;
    margin-right: 5%;
  }

  .contact-banner__heading {
    font-family: Outfit;
    font-weight: 600;
    font-size: 56px;
    line-height: 90%;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
    margin-bottom: 0px;
  }

  .contact-banner__subheading {
    font-size: 18px;
    font-family: Outfit;
    font-weight: 500;
    font-size: 18px;
    line-height: 125%;
    text-align: center;
  }

  /* --------------------
     Responsive Styles
  -------------------- */
  @media (max-width: 991px) {
    .contact-banner__heading {
      font-size: 30px;
    }
    .contact-banner__subheading {
      font-size: 16px;
    }
  }

  @media (max-width: 767px) {
    .contact-banner__heading {
      font-size: 32px !important;
    }
    .contact-banner__subheading {
      font-size: 16px;
    }
    .contact-banner__content--left,
    .contact-banner__content--right {
      text-align: center;
      margin: 0 auto;
    }
  }

  @media (max-width: 480px) {
    .contact-banner__heading {
      font-size: 32px !important;
    }
    .contact-banner__subheading {
      font-size: 16px;
      line-height: 1.5;
    }
  }
{% endstyle %}

<section class="contact-banner">
  <div
    class="contact-banner__background"
    style="background-image: url('{{ section.settings.background_image | img_url: 'master' }}'); height: {{ section.settings.section_height }}px;"
  >
    <div
      class="contact-banner__overlay"
      style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    ></div>

    <div class="contact-banner__content contact-banner__content--{{ section.settings.text_alignment }}">
      <h2 class="contact-banner__heading">{{ section.settings.heading }}</h2>
      <p class="contact-banner__subheading">{{ section.settings.subheading }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Trusted in over 30 countries worldwide, Nutram recipes represent the finest Canadian quality through many decades of pet nutrition excellence."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height (px)",
      "min": 200,
      "max": 800,
      "step": 10,
      "default": 400
    }
  ],
  "presets": [
    {
      "name": "Contact Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
