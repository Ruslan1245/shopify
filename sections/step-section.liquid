{% stylesheet %}
.custom-steps-section {
	text-align: center;
	padding: 50px 20px;
	background-color: #f8f8f8;
	padding-top: 6rem;
}

.custom-steps-section .steps-heading {
	font-size: 56px;
	font-weight: 600;
	margin-bottom: 8px;
	color: #4498CD;
}

.custom-steps-section .steps-heading span.blue {
  color: #0071BC;
}
.custom-steps-section .steps-heading span.green {
  color: #00A651;
}

.custom-steps-section .steps-subtitle {
	font-size: 18px;
	color: #353535;
	margin-bottom: 40px;
}

.custom-steps-section .steps-wrapper {
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;
}

.custom-steps-section .step-item {
  max-width: 260px;
  flex: 1 1 260px;
}

.custom-steps-section .step-image-wrapper {
  position: relative;
  width: 200px;
  height: 200px;
  margin: 0 auto 20px;
  border-radius: 50%;
}

.custom-steps-section .step-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.custom-steps-section .step-number {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translate(-50%, 50%);
  background: #4498cd;
  color: #fff;
  font-weight: 700;
  font-size: 18px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3px solid #fff;
  z-index:0;
}

.custom-steps-section .step-title {
	font-weight: 600;
	color: #4498CD;
	margin-bottom: 5px;
	font-size: 24px;
}

.custom-steps-section .step-text {
	font-size: 16px;
	color: #353535;
}

.custom-steps-section .cta-button {
  margin-top: 40px;
}

.custom-steps-section .cta-button a {
	gap: 8px;
	background-color: #F8C933;
	padding: 12px 25px;
	color: #353535;
	font-weight: 600;
	border-radius: 9999px;
	text-decoration: none;
	max-width: 400px;
	width: 100%;
	font-size: 24px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin: 0 auto;
  position:relative;
  padding-right: 1rem;
}

.custom-steps-section .cta-button a:hover {
  background-color: #E6A800;
}

.custom-steps-section .cta-button a::after {
  content: "";
	background-image: url('https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Vector_5c1622c0-29e6-402a-a815-8da37656e4fc.png?v=1755184216');
	height: 15px;
	width: 30px;
	background-repeat: no-repeat;
	background-size: contain;
}

.custom-steps-section .rating {
	font-size: 14px;
	color: #353535;
	margin-top: 8px;
	text-align: center;
	display: flex;
	justify-content: center;
}

.custom-steps-section .rating span {
  color: #FFC107;
  letter-spacing: 2px;
}

/* Responsive */
@media (max-width: 768px) {
  .custom-steps-section .steps-wrapper {
    gap: 20px;
  }
}
{% endstylesheet %}


<section class="custom-steps-section">
  <h2 class="steps-heading">{{ section.settings.heading }}</h2>
  <div class="steps-subtitle">{{ section.settings.subtitle }}</div>

  <div class="steps-wrapper">
    {% for block in section.blocks %}
      <div class="step-item">
        <div class="step-image-wrapper">
          {% if block.settings.image %}
            <img width="auto" height="auto" src="{{ block.settings.image | img_url: '400x400' }}" alt="">
          {% endif %}
          <div class="step-number">{{ forloop.index }}</div>
        </div>
        <div class="step-title">{{ block.settings.title }}</div>
        <div class="step-text">{{ block.settings.text }}</div>
      </div>
    {% endfor %}
  </div>

  <div class="cta-button">
    <a href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a>
  </div>
  <div class="rating"><span>★★★★★</span> {{ section.settings.rating_text }}</div>
</section>

{% schema %}
{
  "name": "Custom Steps Section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Whole-Food Nutrition In 3 Simple Steps" },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Clean kibbles, for results you can see and your pet can feel."
    },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Best Sellers" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.8/5 Loved by thousands of pet parents"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Step Image" },
        { "type": "text", "id": "title", "label": "Step Title", "default": "Choose Their Formula" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Text",
          "default": "Tailored to your dog, great smoothies, no generic kibble blends."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Custom Steps Section", "category": "Custom" }]
}
{% endschema %}
