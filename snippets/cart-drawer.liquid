{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.

  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is
  added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if settings.auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    on:click="/open"
    aria-label="{{ 'accessibility.open_cart_drawer' | t }} {{ 'accessibility.cart_count' | t}}: {{ cart.item_count }}"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    scroll-lock
  >
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        {%- if cart.empty? -%}
          <div class="cart-drawer__header">
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            <span class="cart-drawer__heading h3 cart-drawer__heading--empty">
              {{ 'content.your_cart_is_empty' | t }}
            </span>

            <div class="cart-drawer__items">
              {% render 'cart-products' %}
            </div>
          </div>
        {%- else -%}
          <div
            class="cart-drawer__header"
            id="cart-drawer-header"
          >
            <span class="cart-drawer__heading h3">
              {{ 'content.cart_title' | t }}
              {% render 'cart-bubble' %}
            </span>

            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- comment -%} BEGIN: Free shipping bar — HTML / CSS / JS (checked twice) {%- endcomment -%}

{%- assign below = section.settings.below_message | default: settings.below_message | strip -%}
{%- assign above = section.settings.above_message | default: settings.above_message | strip -%}
{%- assign threshold = section.settings.free_shipping_threshold | default: settings.free_shipping_threshold -%}
{%- assign initial_total = cart.original_total_price | divided_by: 100 -%}

{%- if below != '' and above != '' and threshold and threshold | plus: 0 > 0 -%}
  {%- comment -%} prepare initial server-side message with a replaced remaining amount {%- endcomment -%}
  {%- assign initial_remaining = threshold | minus: initial_total -%}
  {%- if initial_remaining < 0 %}{%- assign initial_remaining = 0 -%}{%- endif -%}
  {%- assign initial_remaining = initial_remaining | round: 2 -%}
  {%- assign initial_below = below | replace: '{{remaining}}', initial_remaining | replace: '{remaining}', initial_remaining | replace: '55', threshold -%}
  {%- if initial_total >= threshold -%}
    {%- assign initial_msg = above -%}
  {%- else -%}
    {%- assign initial_msg = initial_below -%}
  {%- endif -%}

  <div id="fsb-{{ section.id }}" class="fsb-wrapper" role="region" aria-label="Free shipping progress"
       data-threshold="{{ threshold }}"
       data-below='{{ below | escape }}'
       data-above='{{ above | escape }}'
       data-initial-total='{{ initial_total }}'>

    <div class="fsb-inner">
      <p id="fsb-text-{{ section.id }}" class="fsb-text" aria-live="polite">{{ initial_msg }}</p>

      <div id="fsb-track-{{ section.id }}" class="fsb-track" role="progressbar"
           aria-labelledby="fsb-text-{{ section.id }}"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="fsb-fill-{{ section.id }}" class="fsb-fill" style="width:0%"></div>

        <div id="fsb-truck-{{ section.id }}" class="fsb-truck" aria-hidden="true" style="left:0%;">
          <!-- Truck bubble (white circle with blue truck) -->
          <svg viewBox="0 0 36 36" width="36" height="36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="18" cy="18" r="18" fill="#ffffff"/>
            <g transform="translate(4,6)" fill="#1976D2">
              <path d="M13 6h-1V3a1 1 0 0 0-1-1H1v9h1.5A1.5 1.5 0 0 0 4 12.5V13h1a1 1 0 1 0 0-2h-1v-2h9v1h1a1 1 0 0 0 1-1V7l-2-1zM5 9H2V4h8v5H5z" />
              <circle cx="3.2" cy="10.5" r="1" />
              <circle cx="10.2" cy="10.5" r="1" />
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Free shipping bar: blue theme, rounded */
    .fsb-wrapper {
      background: #eaf6ff;
      border-radius: 10px;
      padding: 12px 14px;
      margin: 12px 0;
      box-sizing: border-box;
      max-width: 100%;
    }

    .fsb-inner { max-width: 100%; }

    .fsb-text {
      font-weight: 700;
      color: #1976D2;
      margin: 0 0 10px;
      font-size: 15px;
      text-align: center;
    }

    .fsb-track {
      position: relative;
      height: 14px;
      background: #d6eefc;
      border-radius: 12px;
      overflow: visible;
      margin: 0 8px;
    }

    .fsb-fill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 0%;
      background: linear-gradient(90deg,#1976D2,#4aa2ea);
      border-radius: 12px;
      transition: width 600ms cubic-bezier(.2,.8,.2,1);
      box-shadow: inset 0 -2px 0 rgba(0,0,0,0.04);
    }

    .fsb-truck {
      position: absolute;
      top: 50%;
      transform: translate(-50%, -50%);
      left: 0%;
      width: 36px;
      height: 36px;
      pointer-events: none;
      transition: left 600ms cubic-bezier(.2,.8,.2,1);
      z-index: 3;
      filter: drop-shadow(0 4px 8px rgba(0,0,0,0.12));
    }

    /* Responsive tweaks */
    @media (max-width: 640px) {
      .fsb-text { font-size: 14px; }
      .fsb-track { height: 12px; }
      .fsb-truck { width: 30px; height: 30px; }
    }
  </style>

  <script>
    (function () {
      // unique IDs
      const id = "{{ section.id }}";
      const wrapper = document.getElementById('fsb-' + id);
      if (!wrapper) return;

      // read settings (from data attributes / Liquid)
      const threshold = Number(wrapper.dataset.threshold) || 0;
      const belowMsgRaw = wrapper.dataset.below || '';
      const aboveMsgRaw = wrapper.dataset.above || '';
      const initialTotal = Number(wrapper.dataset.initialTotal) || 0;

      const textEl = document.getElementById('fsb-text-' + id);
      const fillEl = document.getElementById('fsb-fill-' + id);
      const truckEl = document.getElementById('fsb-truck-' + id);
      const trackEl = document.getElementById('fsb-track-' + id);

      // format money (USD-ish). Adjust if you want currency from shop.locale.
      function fmt(amount) {
        const num = Number(amount) || 0;
        // keep two decimals but show .00 truncated
        const s = num.toFixed(2).replace(/\.00$/, '');
        return '$' + s;
      }

      // Replace placeholders in template: {{remaining}} or {remaining}
      function applyTemplate(template, remaining) {
        if (!template) return '';
        return template
          .replace(/\{\{\s*remaining\s*\}\}/g, fmt(remaining))
          .replace(/\{\s*remaining\s*\}/g, fmt(remaining))
          // fallback: if merchant left literal "55" in text, swap it to threshold
          .replace(/55/g, String(threshold));
      }

      // Update visuals for a given cart total (in dollars)
      function updateVisuals(total) {
        total = Number(total || 0);
        let pct = threshold > 0 ? Math.min((total / threshold) * 100, 100) : 0;
        if (!isFinite(pct)) pct = 0;
        fillEl.style.width = pct + '%';

        // compute truck left with clamping so it doesn't overflow off track
        const trackRect = trackEl.getBoundingClientRect();
        const truckRect = truckEl.getBoundingClientRect ? truckEl.getBoundingClientRect() : { width: 36 };
        const truckHalf = (truckRect.width || 36) / 2;
        let leftPx = (pct / 100) * trackRect.width;
        leftPx = Math.max(truckHalf, Math.min(trackRect.width - truckHalf, leftPx));
        const leftPercent = (leftPx / trackRect.width) * 100;
        truckEl.style.left = leftPercent + '%';

        // accessible value
        trackEl.setAttribute('aria-valuenow', Math.round(pct));

        // message text
        if (total >= threshold) {
          textEl.textContent = aboveMsgRaw;
        } else {
          const remaining = Math.max((threshold - total), 0);
          const msg = applyTemplate(belowMsgRaw, remaining);
          // if merchant didn't include placeholder, append remaining fallback
          if (msg.indexOf('{{remaining}}') === -1 && msg.indexOf('{remaining}') === -1 && !/[\$0-9]+/.test(msg)) {
            textEl.textContent = msg + ' ' + '(' + fmt(remaining) + ' to go)';
          } else {
            textEl.textContent = msg;
          }
        }
      }

      // fetch cart and update (cart prices in cents)
      function fetchCartAndUpdate() {
        return fetch('/cart.js', { credentials: 'same-origin' })
          .then(function (res) {
            if (!res.ok) throw new Error('Network response not ok');
            return res.json();
          })
          .then(function (cart) {
            // prefer original_total_price if available (pre-discounts), else total_price
            const rawCents = (typeof cart.original_total_price !== 'undefined') ? cart.original_total_price : cart.total_price;
            const total = (Number(rawCents) || 0) / 100;
            updateVisuals(total);
          })
          .catch(function () {
            // fallback to server-provided initial total
            updateVisuals(initialTotal);
          });
      }

      // initial render using server-side value then refresh with live cart
      updateVisuals(initialTotal);
      fetchCartAndUpdate();

      // expose function so other theme JS can refresh when items change
      window.refreshFreeShippingBar = window.refreshFreeShippingBar || function () {
        fetchCartAndUpdate();
      };

      // listen to common cart update events used by themes
      window.addEventListener('cart:updated', fetchCartAndUpdate);
      window.addEventListener('cart:refresh', fetchCartAndUpdate);

      // small MutationObserver to try to catch dynamic cart changes (will disconnect after 25s)
      try {
        const obs = new MutationObserver(function () {
          fetchCartAndUpdate();
        });
        obs.observe(document.body, { childList: true, subtree: true });
        setTimeout(function () { obs.disconnect(); }, 25000);
      } catch (e) { /* ignore */ }
    })();
  </script>

{%- endif -%}
{%- comment -%} END: Free shipping bar {%- endcomment -%}


          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
            style="--header-height: 60px;"
          >
            <scroll-hint
              class="cart-drawer__items"
            >
              {% render 'cart-products' %}
            </scroll-hint>

            <div
              class="cart-drawer__summary"
            >
              {% render 'cart-summary' %}
            </div>
          </div>
        {%- endif -%}
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__header {
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--cart-drawer-padding);
    border-bottom: var(--style-border-width) solid none;
    position: sticky;
    top: 0;
    z-index: 1;

    @media screen and (min-width: 750px) {
      padding: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-drawer__dialog {
    overflow: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
  }
{% endstylesheet %}
