{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.

  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is
  added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

 
<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>


<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if settings.auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    on:click="/open"
    aria-label="{{ 'accessibility.open_cart_drawer' | t }} {{ 'accessibility.cart_count' | t}}: {{ cart.item_count }}"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    scroll-lock
  >
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        {{ cart.item_count }}
        {%- if cart.empty? -%}
          <div class="cart-drawer__header">
            <div class="cart__drawer__emptytop">
              <div class="cart_icon"><img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Group_1.png?v=1756048209"></div>
              <div class="cart_content">Your cart (0 Item)</div>
            </div>
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            <div class="cart-empty-box">
              <div class="cart-empty-box__rating">⭐⭐⭐⭐⭐ <span>4.8/5 loved by thousands of pet parents</span></div>

              <h2 class="cart-empty-box__heading">Your Cart Is Empty</h2>

              {% if settings.below_message_cart %}
                <p class="cart-empty-box__subtext">
                  {{ settings.below_message_cart }}
                </p>
              {% endif %}

              <div class="cart-empty-box__buttons">
                {% if settings.first_btn_1 and settings.first_btn_1_url %}
                  <a
                    href="{{ settings.first_btn_1_url }}"
                    class="cart-empty-box__button cart-empty-box__button--primary"
                  >
                    {{ settings.first_btn_1 }}
                  </a>
                {% endif %}

                {% if settings.second_btn_2 and settings.second_btn__url %}
                  <a
                    href="{{ settings.second_btn__url }}"
                    class="cart-empty-box__button cart-empty-box__button--secondary"
                  >
                    {{ settings.second_btn_2 }}
                  </a>
                {% endif %}
              </div>
            </div>

            {% if settings.upsell_products != blank %}
              <div class="upsell-wrapper">
                <div class="swiper upsell-swiper-empty">
                  <div class="swiper-wrapper">
                    {% for product in settings.upsell_products %}
                      <div class="swiper-slide upsell-product-card">
                        <div class="product-image">
                          <a href="{{ product.url }}">
                            <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
                          </a>
                        </div>
                        <div class="product-info">
                          <div class="product-rating"><span>★</span> 4.8/5 (100 reviews)</div>
                          <h4 class="product-title">{{ product.title }}</h4>
                          <p class="product-price">From {{ product.price | money }}</p>
                          <p class="upsell-message">{{ settings.upsell_message }}</p>
                          <form method="post" action="/cart/add">
                            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                            <button type="submit" class="shopify-buy-button">
                              {{ settings.upsell_button_text }}
                            </button>
                          </form>
                        </div>
                      </div>
                    {% endfor %}
                  </div>

                  <!-- Unique Swiper Arrows -->
                  <div class="swiper-button-prev swiper-prev-empty"></div>
                  <div class="swiper-button-next swiper-next-empty"></div>
                </div>
              </div>
            {% endif %}

            
          </div>
          <div class="cart_bottom_custom">
              <a href="/collections/all">Explore All Products</a>
              <div class="cart-empty-box__rating">⭐⭐⭐⭐⭐ <span>4.8/5 loved by thousands of pet parents</span></div>
            </div>
        {%- else -%}
          <div
            class="cart-drawer__header"
            id="cart-drawer-header"
          >
            <span class="cart-drawer__heading h3">
              <span class="cart_drawer__icon"><img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/Group_1.png?v=1756048209"></span>
              your cart ({{ cart.item_count }} items)
              {% comment %} {% render 'cart-bubble' %} {% endcomment %}
            </span>

            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {% assign cart_total = cart.original_total_price | divided_by: 100 %}
          {% assign threshold = settings.free_shipping_threshold %}
          {% assign remaining = threshold | minus: cart_total %}

          <div class="free-shipping-wrapper">
            <p class="shipping-message">
              {% if cart_total >= threshold %}
                {{ settings.above_message }}
              {% else %}
                {{ settings.below_message }} You are only <strong>${{ remaining }}</strong> away!
              {% endif %}
            </p>

            <div class="shipping-progress">
              <div
                class="shipping-progress-fill"
                style="width: {{ cart_total | times: 100 | divided_by: threshold | at_most: 100 }}%;"
              >
                <div class="shipping-truck"><img src="https://cdn.shopify.com/s/files/1/0627/0422/2426/files/1.png?v=1756050343"></div>
              </div>
            </div>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
            style="--header-height: 60px;"
          >
            <scroll-hint
              class="cart-drawer__items"
            >
              {% render 'cart-products' %}
              {% if settings.upsell_products != blank %}
                <div class="upsell-wrapper">
                  <h3 class="upsell-heading">{{ settings.upsell_heading }}</h3>

                  <div class="swiper upsell-swiper">
                    <div class="swiper-wrapper">
                      {% for product in settings.upsell_products %}
                        <div class="swiper-slide upsell-product-card">
                          <div class="product-image">
                            <a href="{{ product.url }}">
                              <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
                            </a>
                          </div>
                          <div class="product-info">
                            <div class="product-rating">★ 4.8/5 (100 reviews)</div>
                            <h4 class="product-title">{{ product.title }}</h4>
                            <p class="product-price">From {{ product.price | money }}</p>
                            <p class="upsell-message">{{ settings.upsell_message }}</p>
                            <form method="post" action="/cart/add">
                              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                              <button type="submit" class="shopify-buy-button">
                                {{ settings.upsell_button_text }}
                              </button>
                            </form>
                          </div>
                        </div>
                      {% endfor %}
                    </div>

                    <!-- Arrows -->
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                  </div>
                </div>
              {% endif %}
            </scroll-hint>

            <div
              class="cart-drawer__summary"
            >
              {% render 'cart-summary' %}
            </div>
          </div>
        {%- endif -%}
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__header {
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--cart-drawer-padding);
    border-bottom: var(--style-border-width) solid none;
    position: sticky;
    top: 0;
    z-index: 1;

    @media screen and (min-width: 750px) {
      padding: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-drawer__dialog {
    overflow: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
  }

{% endstylesheet %}

